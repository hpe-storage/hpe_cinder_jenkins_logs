[2026-09-01T05:04:17.717Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-09-01T05:04:17.717Z]                         cd /opt/stack/tempest
[2026-09-01T05:04:17.717Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
