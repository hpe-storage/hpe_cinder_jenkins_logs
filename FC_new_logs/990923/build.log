[2026-08-13T18:16:00.457Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-13T18:16:00.457Z]                         if [ -z "$image_id" ]; then
