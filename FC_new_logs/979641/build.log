[2026-07-01T18:02:40.311Z]                         # Extract image_id from the DevStack-generated tempest.conf before overwriting it
[2026-07-01T18:02:40.311Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-01T18:02:40.311Z]                         if [ -z "$image_id" ]; then
[2026-07-01T18:02:40.311Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-01T18:02:40.311Z]                             exit 1
[2026-07-01T18:02:40.311Z]                         fi
[2026-07-01T18:02:40.311Z]                         echo "image_id: $image_id"
[2026-07-01T18:02:40.311Z] 
[2026-07-01T18:02:40.311Z]                         # Download FC-specific tempest.conf and skip list
[2026-07-01T18:02:40.311Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-01T18:02:40.311Z]                         cd /opt/stack/tempest
[2026-07-01T18:02:40.311Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-07-01T18:02:40.311Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-07-01T18:02:40.311Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-01T18:02:40.311Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-07-01T18:02:40.311Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
