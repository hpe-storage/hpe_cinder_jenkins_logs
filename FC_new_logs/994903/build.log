[2026-07-23T03:34:59.332Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-23T03:34:59.332Z]                         cd /opt/stack/tempest
[2026-07-23T03:34:59.332Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
