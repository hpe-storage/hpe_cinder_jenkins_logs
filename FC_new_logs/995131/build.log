[2026-07-01T10:29:45.150Z]                         HOST_IP=$(hostname -I | cut -d" " -f1)
[2026-07-01T10:29:45.150Z]                         export no_proxy=${no_proxy:-},localhost,127.0.0.1,${HOST_IP}
[2026-07-01T10:29:45.150Z]                         set -ex
[2026-07-01T10:29:45.150Z] 
[2026-07-01T10:29:45.150Z]                         . /opt/stack/devstack/openrc admin admin
[2026-07-01T10:29:45.150Z] 
[2026-07-01T10:29:45.150Z]                         # Create the public subnet used by Tempest floating IPs (FC range)
[2026-07-01T10:29:45.150Z]                         openstack subnet create public_subnet                             --allocation-pool start=10.132.239.72,end=10.132.239.73                             --network public                             --subnet-range 10.132.239.0/24
[2026-07-01T10:29:45.150Z] 
[2026-07-01T10:29:45.150Z]                         # Extract image_id from the DevStack-generated tempest.conf before overwriting it
[2026-07-01T10:29:45.150Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-01T10:29:45.150Z]                         if [ -z "$image_id" ]; then
[2026-07-01T10:29:45.150Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-01T10:29:45.150Z]                             exit 1
[2026-07-01T10:29:45.150Z]                         fi
[2026-07-01T10:29:45.150Z]                         echo "image_id: $image_id"
[2026-07-01T10:29:45.150Z] 
[2026-07-01T10:29:45.150Z]                         # Download FC-specific tempest.conf and skip list
[2026-07-01T10:29:45.150Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-01T10:29:45.150Z]                         cd /opt/stack/tempest
[2026-07-01T10:29:45.150Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-07-01T10:29:45.150Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-07-01T10:29:45.150Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-01T10:29:45.150Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-07-01T10:29:45.150Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-07-01T10:29:45.150Z] 
[2026-07-01T10:29:45.150Z]                         . .tox/tempest/bin/activate
[2026-07-01T10:29:45.150Z]                         export TERM=xterm-256color
[2026-07-01T10:29:45.150Z]                         export OS_TEST_TIMEOUT=3000
[2026-07-01T10:29:45.150Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
