[2026-06-29T11:12:02.904Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-06-29T11:12:02.904Z]             if (! (section, attr) in cfg_attr_count) {
[2026-06-29T11:12:02.904Z]                 if (section != last_section) {
[2026-06-29T11:12:02.904Z]                     cfg_section[section_count++] = section
[2026-06-29T11:12:02.904Z]                     last_section = section
[2026-06-29T11:12:02.904Z]                 }
[2026-06-29T11:12:02.904Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-06-29T11:12:02.904Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-06-29T11:12:02.904Z] 
[2026-06-29T11:12:02.904Z]                 cfg_attr[section, attr, 0] = value
[2026-06-29T11:12:02.904Z]                 cfg_attr_count[section, attr] = 1
[2026-06-29T11:12:02.904Z]             } else {
[2026-06-29T11:12:02.904Z]                 lno = cfg_attr_count[section, attr]++
[2026-06-29T11:12:02.904Z]                 cfg_attr[section, attr, lno] = value
