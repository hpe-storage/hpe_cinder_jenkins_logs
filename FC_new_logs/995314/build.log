[2026-07-01T08:09:07.651Z]         END {
[2026-07-01T08:09:07.651Z]             # Process each section in order
[2026-07-01T08:09:07.651Z]             for (sno = 0; sno < section_count; sno++) {
[2026-07-01T08:09:07.651Z]                 section = cfg_section[sno]
[2026-07-01T08:09:07.651Z]                 # The ini routines simply append a config item immediately
[2026-07-01T08:09:07.651Z]                 # after the section header. To keep the same order as defined
[2026-07-01T08:09:07.651Z]                 # in local.conf, invoke the ini routines in the reverse order
