[2026-07-01T08:09:07.651Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-07-01T08:09:07.651Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-07-01T08:09:07.651Z]                     else {
