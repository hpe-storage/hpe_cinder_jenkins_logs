[2026-06-29T11:12:02.904Z]                 section = cfg_section[sno]
[2026-06-29T11:12:02.904Z]                 # The ini routines simply append a config item immediately
[2026-06-29T11:12:02.904Z]                 # after the section header. To keep the same order as defined
[2026-06-29T11:12:02.904Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-06-29T11:12:02.904Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-06-29T11:12:02.904Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-06-29T11:12:02.904Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-06-29T11:12:02.904Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-06-29T11:12:02.904Z]                     else {
[2026-06-29T11:12:02.904Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-06-29T11:12:02.904Z]                         count = cfg_attr_count[section, attr]
[2026-06-29T11:12:02.904Z]                         print "inidelete " configfile " " section " " attr
[2026-06-29T11:12:02.904Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-06-29T11:12:02.904Z]                         for (l = count -2; l >= 0; l--)
[2026-06-29T11:12:02.904Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-06-29T11:12:02.904Z]                     }
[2026-06-29T11:12:02.904Z]                 }
[2026-06-29T11:12:02.904Z]             }
[2026-06-29T11:12:02.904Z]         }
[2026-06-29T11:12:02.904Z]     '
