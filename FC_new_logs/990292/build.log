[2026-09-02T07:41:15.384Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-09-02T07:41:15.384Z]                         cd /opt/stack/tempest
[2026-09-02T07:41:15.384Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-02T07:41:15.384Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-09-02T07:41:15.384Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-02T07:41:15.384Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-09-02T07:41:15.384Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
