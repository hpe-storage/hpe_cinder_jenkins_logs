[2026-09-02T07:41:15.384Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-02T07:41:15.384Z]                         if [ -z "$image_id" ]; then
