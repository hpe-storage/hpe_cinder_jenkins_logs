[2026-07-01T22:52:32.265Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-01T22:52:32.265Z]                         if [ -z "$image_id" ]; then
[2026-07-01T22:52:32.265Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-01T22:52:32.265Z]                             exit 1
[2026-07-01T22:52:32.265Z]                         fi
[2026-07-01T22:52:32.265Z]                         echo "image_id: $image_id"
[2026-07-01T22:52:32.265Z] 
[2026-07-01T22:52:32.265Z]                         # Download FC-specific tempest.conf and skip list
[2026-07-01T22:52:32.265Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-01T22:52:32.265Z]                         cd /opt/stack/tempest
[2026-07-01T22:52:32.265Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-07-01T22:52:32.265Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-07-01T22:52:32.265Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-01T22:52:32.265Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-07-01T22:52:32.265Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
