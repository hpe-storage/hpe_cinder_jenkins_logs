[2026-07-01T17:14:01.106Z]                         # Extract image_id from the DevStack-generated tempest.conf before overwriting it
[2026-07-01T17:14:01.106Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-01T17:14:01.106Z]                         if [ -z "$image_id" ]; then
[2026-07-01T17:14:01.106Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-01T17:14:01.106Z]                             exit 1
[2026-07-01T17:14:01.106Z]                         fi
[2026-07-01T17:14:01.106Z]                         echo "image_id: $image_id"
[2026-07-01T17:14:01.106Z] 
[2026-07-01T17:14:01.106Z]                         # Download FC-specific tempest.conf and skip list
[2026-07-01T17:14:01.106Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-01T17:14:01.106Z]                         cd /opt/stack/tempest
[2026-07-01T17:14:01.106Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-07-01T17:14:01.106Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-07-01T17:14:01.106Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-01T17:14:01.106Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-07-01T17:14:01.106Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-07-01T17:14:01.106Z] 
[2026-07-01T17:14:01.106Z]                         . .tox/tempest/bin/activate
[2026-07-01T17:14:01.106Z]                         export TERM=xterm-256color
[2026-07-01T17:14:01.106Z]                         export OS_TEST_TIMEOUT=3000
[2026-07-01T17:14:01.106Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
