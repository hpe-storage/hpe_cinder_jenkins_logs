[2026-07-23T04:27:31.833Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-23T04:27:31.833Z]                         if [ -z "$image_id" ]; then
