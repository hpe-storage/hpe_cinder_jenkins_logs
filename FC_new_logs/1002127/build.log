[2026-08-24T15:16:03.968Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-08-24T15:16:03.968Z]                         cd /opt/stack/tempest
[2026-08-24T15:16:03.968Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
