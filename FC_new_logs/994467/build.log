[2026-06-30T18:55:17.588Z]         /^\[.+\]/ {
[2026-06-30T18:55:17.588Z]             gsub("[][]", "", $1);
[2026-06-30T18:55:17.588Z]             section=$1
[2026-06-30T18:55:17.588Z]             next
[2026-06-30T18:55:17.588Z]         }
[2026-06-30T18:55:17.588Z]         /^ *\#/ {
[2026-06-30T18:55:17.588Z]             next
[2026-06-30T18:55:17.588Z]         }
[2026-06-30T18:55:17.588Z]         /^[^ \t]+/ {
[2026-06-30T18:55:17.588Z]             # get offset of first = in $0
[2026-06-30T18:55:17.588Z]             eq_idx = index($0, "=")
[2026-06-30T18:55:17.588Z]             # extract attr & value from $0
[2026-06-30T18:55:17.588Z]             attr = substr($0, 1, eq_idx - 1)
[2026-06-30T18:55:17.588Z]             value = substr($0, eq_idx + 1)
[2026-06-30T18:55:17.588Z]             # only need to strip trailing whitespace from attr
[2026-06-30T18:55:17.588Z]             sub(/[ \t]*$/, "", attr)
[2026-06-30T18:55:17.588Z]             # need to strip leading & trailing whitespace from value
[2026-06-30T18:55:17.588Z]             sub(/^[ \t]*/, "", value)
[2026-06-30T18:55:17.588Z]             sub(/[ \t]*$/, "", value)
[2026-06-30T18:55:17.588Z] 
[2026-06-30T18:55:17.588Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-06-30T18:55:17.588Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-06-30T18:55:17.588Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-06-30T18:55:17.588Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-06-30T18:55:17.588Z]             if (! (section, attr) in cfg_attr_count) {
[2026-06-30T18:55:17.588Z]                 if (section != last_section) {
[2026-06-30T18:55:17.588Z]                     cfg_section[section_count++] = section
[2026-06-30T18:55:17.588Z]                     last_section = section
[2026-06-30T18:55:17.588Z]                 }
[2026-06-30T18:55:17.588Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-06-30T18:55:17.588Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-06-30T18:55:17.588Z] 
[2026-06-30T18:55:17.588Z]                 cfg_attr[section, attr, 0] = value
[2026-06-30T18:55:17.588Z]                 cfg_attr_count[section, attr] = 1
[2026-06-30T18:55:17.588Z]             } else {
[2026-06-30T18:55:17.588Z]                 lno = cfg_attr_count[section, attr]++
[2026-06-30T18:55:17.588Z]                 cfg_attr[section, attr, lno] = value
[2026-06-30T18:55:17.588Z]             }
[2026-06-30T18:55:17.588Z]         }
[2026-06-30T18:55:17.588Z]         END {
[2026-06-30T18:55:17.588Z]             # Process each section in order
[2026-06-30T18:55:17.588Z]             for (sno = 0; sno < section_count; sno++) {
[2026-06-30T18:55:17.588Z]                 section = cfg_section[sno]
[2026-06-30T18:55:17.588Z]                 # The ini routines simply append a config item immediately
[2026-06-30T18:55:17.588Z]                 # after the section header. To keep the same order as defined
[2026-06-30T18:55:17.588Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-06-30T18:55:17.588Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-06-30T18:55:17.588Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-06-30T18:55:17.588Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-06-30T18:55:17.588Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-06-30T18:55:17.588Z]                     else {
