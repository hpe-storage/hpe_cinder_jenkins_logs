[2026-06-30T18:08:19.530Z]         /^ *\#/ {
[2026-06-30T18:08:19.530Z]             next
[2026-06-30T18:08:19.530Z]         }
[2026-06-30T18:08:19.530Z]         /^[^ \t]+/ {
[2026-06-30T18:08:19.530Z]             # get offset of first = in $0
[2026-06-30T18:08:19.530Z]             eq_idx = index($0, "=")
[2026-06-30T18:08:19.530Z]             # extract attr & value from $0
[2026-06-30T18:08:19.530Z]             attr = substr($0, 1, eq_idx - 1)
[2026-06-30T18:08:19.530Z]             value = substr($0, eq_idx + 1)
[2026-06-30T18:08:19.530Z]             # only need to strip trailing whitespace from attr
[2026-06-30T18:08:19.530Z]             sub(/[ \t]*$/, "", attr)
[2026-06-30T18:08:19.530Z]             # need to strip leading & trailing whitespace from value
[2026-06-30T18:08:19.530Z]             sub(/^[ \t]*/, "", value)
[2026-06-30T18:08:19.530Z]             sub(/[ \t]*$/, "", value)
[2026-06-30T18:08:19.530Z] 
[2026-06-30T18:08:19.530Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-06-30T18:08:19.530Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
