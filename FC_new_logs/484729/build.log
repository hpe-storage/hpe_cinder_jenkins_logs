[2026-06-30T18:08:19.530Z]                 cfg_attr_count[section, attr] = 1
[2026-06-30T18:08:19.530Z]             } else {
[2026-06-30T18:08:19.530Z]                 lno = cfg_attr_count[section, attr]++
[2026-06-30T18:08:19.530Z]                 cfg_attr[section, attr, lno] = value
