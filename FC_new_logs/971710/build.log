[2026-07-03T08:56:26.463Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-03T08:56:26.463Z]                         if [ -z "$image_id" ]; then
[2026-07-03T08:56:26.463Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-03T08:56:26.463Z]                             exit 1
[2026-07-03T08:56:26.463Z]                         fi
[2026-07-03T08:56:26.463Z]                         echo "image_id: $image_id"
[2026-07-03T08:56:26.463Z] 
[2026-07-03T08:56:26.463Z]                         # Download FC-specific tempest.conf and skip list
[2026-07-03T08:56:26.463Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-07-03T08:56:26.463Z]                         cd /opt/stack/tempest
[2026-07-03T08:56:26.463Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-07-03T08:56:26.463Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-07-03T08:56:26.463Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-03T08:56:26.463Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-07-03T08:56:26.463Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
