[2026-07-02T03:45:24.250Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-02T03:45:24.250Z]                         if [ -z "$image_id" ]; then
