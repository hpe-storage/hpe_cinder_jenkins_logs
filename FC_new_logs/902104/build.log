[2026-08-19T02:17:13.291Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-19T02:17:13.291Z]                         if [ -z "$image_id" ]; then
