[2026-08-31T13:02:17.876Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-08-31T13:02:17.876Z]                         cd /opt/stack/tempest
[2026-08-31T13:02:17.876Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-08-31T13:02:17.876Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-08-31T13:02:17.876Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
