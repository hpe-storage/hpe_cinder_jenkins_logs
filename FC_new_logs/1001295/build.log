[2026-08-31T13:02:17.876Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-31T13:02:17.876Z]                         if [ -z "$image_id" ]; then
[2026-08-31T13:02:17.876Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-08-31T13:02:17.876Z]                             exit 1
[2026-08-31T13:02:17.876Z]                         fi
[2026-08-31T13:02:17.876Z]                         echo "image_id: $image_id"
[2026-08-31T13:02:17.876Z] 
