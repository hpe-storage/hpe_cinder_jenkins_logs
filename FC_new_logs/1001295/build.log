[2026-08-18T10:40:11.375Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-18T10:40:11.375Z]                         if [ -z "$image_id" ]; then
[2026-08-18T10:40:11.375Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-08-18T10:40:11.375Z]                             exit 1
[2026-08-18T10:40:11.375Z]                         fi
[2026-08-18T10:40:11.375Z]                         echo "image_id: $image_id"
