[2026-10-27T14:57:35.418Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-27T14:57:35.418Z] 
[2026-10-27T14:57:35.418Z]                 cfg_attr[section, attr, 0] = value
[2026-10-27T14:57:35.418Z]                 cfg_attr_count[section, attr] = 1
[2026-10-27T14:57:35.418Z]             } else {
[2026-10-27T14:57:35.418Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-27T14:57:35.418Z]                 cfg_attr[section, attr, lno] = value
[2026-10-27T14:57:35.418Z]             }
