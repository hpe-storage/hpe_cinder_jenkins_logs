[2026-11-23T21:08:11.564Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-11-23T21:08:11.564Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-23T21:08:11.564Z]                         if [ -z "$image_id" ]; then
