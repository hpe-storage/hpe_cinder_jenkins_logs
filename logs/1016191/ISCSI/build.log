[2026-11-20T18:19:22.811Z]         BEGIN {
[2026-11-20T18:19:22.811Z]             section = ""
[2026-11-20T18:19:22.811Z]             last_section = ""
[2026-11-20T18:19:22.811Z]             section_count = 0
[2026-11-20T18:19:22.811Z]         }
[2026-11-20T18:19:22.811Z]         /^\[.+\]/ {
[2026-11-20T18:19:22.811Z]             gsub("[][]", "", $1);
[2026-11-20T18:19:22.811Z]             section=$1
[2026-11-20T18:19:22.811Z]             next
[2026-11-20T18:19:22.811Z]         }
[2026-11-20T18:19:22.811Z]         /^ *\#/ {
[2026-11-20T18:19:22.811Z]             next
[2026-11-20T18:19:22.811Z]         }
[2026-11-20T18:19:22.811Z]         /^[^ \t]+/ {
[2026-11-20T18:19:22.812Z]             # get offset of first = in $0
[2026-11-20T18:19:22.812Z]             eq_idx = index($0, "=")
[2026-11-20T18:19:22.812Z]             # extract attr & value from $0
[2026-11-20T18:19:22.812Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-20T18:19:22.812Z]             value = substr($0, eq_idx + 1)
[2026-11-20T18:19:22.812Z]             # only need to strip trailing whitespace from attr
[2026-11-20T18:19:22.812Z]             sub(/[ \t]*$/, "", attr)
[2026-11-20T18:19:22.812Z]             # need to strip leading & trailing whitespace from value
[2026-11-20T18:19:22.812Z]             sub(/^[ \t]*/, "", value)
[2026-11-20T18:19:22.812Z]             sub(/[ \t]*$/, "", value)
[2026-11-20T18:19:22.812Z] 
[2026-11-20T18:19:22.812Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-11-20T18:19:22.812Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-11-20T18:19:22.812Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-11-20T18:19:22.812Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-11-20T18:19:22.812Z]             if (! (section, attr) in cfg_attr_count) {
[2026-11-20T18:19:22.812Z]                 if (section != last_section) {
[2026-11-20T18:19:22.812Z]                     cfg_section[section_count++] = section
[2026-11-20T18:19:22.812Z]                     last_section = section
[2026-11-20T18:19:22.812Z]                 }
[2026-11-20T18:19:22.812Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-11-20T18:19:22.812Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-11-20T18:19:22.812Z] 
[2026-11-20T18:19:22.812Z]                 cfg_attr[section, attr, 0] = value
[2026-11-20T18:19:22.812Z]                 cfg_attr_count[section, attr] = 1
[2026-11-20T18:19:22.812Z]             } else {
[2026-11-20T18:19:22.812Z]                 lno = cfg_attr_count[section, attr]++
[2026-11-20T18:19:22.812Z]                 cfg_attr[section, attr, lno] = value
[2026-11-20T18:19:22.812Z]             }
[2026-11-20T18:19:22.812Z]         }
[2026-11-20T18:19:22.813Z]         END {
[2026-11-20T18:19:22.813Z]             # Process each section in order
[2026-11-20T18:19:22.813Z]             for (sno = 0; sno < section_count; sno++) {
[2026-11-20T18:19:22.813Z]                 section = cfg_section[sno]
[2026-11-20T18:19:22.813Z]                 # The ini routines simply append a config item immediately
[2026-11-20T18:19:22.813Z]                 # after the section header. To keep the same order as defined
[2026-11-20T18:19:22.813Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-11-20T18:19:22.813Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-11-20T18:19:22.813Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-11-20T18:19:22.813Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-11-20T18:19:22.813Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-11-20T18:19:22.813Z]                     else {
