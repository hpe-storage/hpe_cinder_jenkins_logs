[2026-11-20T18:19:22.813Z]                         count = cfg_attr_count[section, attr]
[2026-11-20T18:19:22.813Z]                         print "inidelete " configfile " " section " " attr
[2026-11-20T18:19:22.813Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-20T18:19:22.813Z]                         for (l = count -2; l >= 0; l--)
[2026-11-20T18:19:22.813Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-11-20T18:19:22.813Z]                     }
[2026-11-20T18:19:22.813Z]                 }
[2026-11-20T18:19:22.813Z]             }
