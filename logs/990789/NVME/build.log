[2026-10-19T07:35:41.311Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-10-19T07:35:41.311Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-19T07:35:41.311Z]                         if [ -z "$image_id" ]; then
