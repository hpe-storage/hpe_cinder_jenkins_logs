[2026-10-26T22:45:18.339Z] 
[2026-10-26T22:45:18.339Z]                         for i in $(seq 1 30); do
[2026-10-26T22:45:18.339Z]                             STATUS=$(openstack volume show "$VOL_ID" -f value -c status)
[2026-10-26T22:45:18.339Z]                             echo "Volume status: $STATUS (attempt $i/30)"
[2026-10-26T22:45:18.339Z]                             if [ "$STATUS" = "available" ]; then
[2026-10-26T22:45:18.339Z]                                 break
[2026-10-26T22:45:18.339Z]                             elif [ "$STATUS" = "error" ]; then
[2026-10-26T22:45:18.339Z]                                 echo "Volume creation failed!"
[2026-10-26T22:45:18.339Z]                                 openstack volume show "$VOL_ID"
[2026-10-26T22:45:18.339Z]                                 exit 1
[2026-10-26T22:45:18.339Z]                             fi
[2026-10-26T22:45:18.339Z]                             sleep 10
[2026-10-26T22:45:18.339Z]                         done
[2026-10-26T22:45:18.339Z] 
[2026-10-26T22:45:18.339Z]                         openstack volume show "$VOL_ID"
[2026-10-26T22:45:18.339Z]                         openstack volume delete "$VOL_ID"
[2026-10-26T22:45:18.339Z]                         echo "Smoke test passed."
