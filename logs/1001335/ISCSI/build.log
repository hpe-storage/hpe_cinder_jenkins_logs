[2026-10-19T02:58:21.191Z]         BEGIN {
[2026-10-19T02:58:21.191Z]             section = ""
[2026-10-19T02:58:21.191Z]             last_section = ""
[2026-10-19T02:58:21.191Z]             section_count = 0
[2026-10-19T02:58:21.191Z]         }
[2026-10-19T02:58:21.191Z]         /^\[.+\]/ {
[2026-10-19T02:58:21.191Z]             gsub("[][]", "", $1);
[2026-10-19T02:58:21.191Z]             section=$1
[2026-10-19T02:58:21.191Z]             next
[2026-10-19T02:58:21.191Z]         }
[2026-10-19T02:58:21.191Z]         /^ *\#/ {
[2026-10-19T02:58:21.191Z]             next
[2026-10-19T02:58:21.191Z]         }
[2026-10-19T02:58:21.191Z]         /^[^ \t]+/ {
[2026-10-19T02:58:21.191Z]             # get offset of first = in $0
[2026-10-19T02:58:21.191Z]             eq_idx = index($0, "=")
[2026-10-19T02:58:21.191Z]             # extract attr & value from $0
[2026-10-19T02:58:21.191Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-19T02:58:21.191Z]             value = substr($0, eq_idx + 1)
[2026-10-19T02:58:21.191Z]             # only need to strip trailing whitespace from attr
[2026-10-19T02:58:21.191Z]             sub(/[ \t]*$/, "", attr)
[2026-10-19T02:58:21.191Z]             # need to strip leading & trailing whitespace from value
[2026-10-19T02:58:21.191Z]             sub(/^[ \t]*/, "", value)
[2026-10-19T02:58:21.191Z]             sub(/[ \t]*$/, "", value)
[2026-10-19T02:58:21.191Z] 
[2026-10-19T02:58:21.191Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-10-19T02:58:21.191Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-10-19T02:58:21.191Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-10-19T02:58:21.191Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-10-19T02:58:21.191Z]             if (! (section, attr) in cfg_attr_count) {
[2026-10-19T02:58:21.191Z]                 if (section != last_section) {
[2026-10-19T02:58:21.191Z]                     cfg_section[section_count++] = section
[2026-10-19T02:58:21.191Z]                     last_section = section
[2026-10-19T02:58:21.192Z]                 }
[2026-10-19T02:58:21.192Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-10-19T02:58:21.192Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-19T02:58:21.192Z] 
[2026-10-19T02:58:21.192Z]                 cfg_attr[section, attr, 0] = value
[2026-10-19T02:58:21.192Z]                 cfg_attr_count[section, attr] = 1
[2026-10-19T02:58:21.192Z]             } else {
[2026-10-19T02:58:21.192Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-19T02:58:21.192Z]                 cfg_attr[section, attr, lno] = value
[2026-10-19T02:58:21.192Z]             }
[2026-10-19T02:58:21.192Z]         }
[2026-10-19T02:58:21.192Z]         END {
[2026-10-19T02:58:21.192Z]             # Process each section in order
[2026-10-19T02:58:21.192Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-19T02:58:21.192Z]                 section = cfg_section[sno]
[2026-10-19T02:58:21.192Z]                 # The ini routines simply append a config item immediately
[2026-10-19T02:58:21.192Z]                 # after the section header. To keep the same order as defined
[2026-10-19T02:58:21.192Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-10-19T02:58:21.192Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-10-19T02:58:21.192Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-10-19T02:58:21.192Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-10-19T02:58:21.192Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-10-19T02:58:21.192Z]                     else {
[2026-10-19T02:58:21.192Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-10-19T02:58:21.192Z]                         count = cfg_attr_count[section, attr]
[2026-10-19T02:58:21.192Z]                         print "inidelete " configfile " " section " " attr
[2026-10-19T02:58:21.193Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-19T02:58:21.193Z]                         for (l = count -2; l >= 0; l--)
[2026-10-19T02:58:21.193Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-10-19T02:58:21.193Z]                     }
[2026-10-19T02:58:21.193Z]                 }
[2026-10-19T02:58:21.193Z]             }
