[2026-10-05T11:10:40.777Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-05T11:10:40.777Z]                         if [ -z "$image_id" ]; then
