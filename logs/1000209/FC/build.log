[2026-10-30T16:59:36.258Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-10-30T16:59:36.258Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
