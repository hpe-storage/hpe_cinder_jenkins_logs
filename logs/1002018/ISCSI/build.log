[2026-09-15T04:28:09.786Z]         /^[^ \t]+/ {
[2026-09-15T04:28:09.786Z]             # get offset of first = in $0
[2026-09-15T04:28:09.786Z]             eq_idx = index($0, "=")
[2026-09-15T04:28:09.786Z]             # extract attr & value from $0
[2026-09-15T04:28:09.786Z]             attr = substr($0, 1, eq_idx - 1)
[2026-09-15T04:28:09.786Z]             value = substr($0, eq_idx + 1)
[2026-09-15T04:28:09.786Z]             # only need to strip trailing whitespace from attr
[2026-09-15T04:28:09.787Z]             sub(/[ \t]*$/, "", attr)
[2026-09-15T04:28:09.787Z]             # need to strip leading & trailing whitespace from value
[2026-09-15T04:28:09.787Z]             sub(/^[ \t]*/, "", value)
[2026-09-15T04:28:09.787Z]             sub(/[ \t]*$/, "", value)
[2026-09-15T04:28:09.787Z] 
