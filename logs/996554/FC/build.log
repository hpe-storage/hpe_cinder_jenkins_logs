[2026-09-02T16:28:33.449Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-02T16:28:33.449Z]                         if [ -z "$image_id" ]; then
