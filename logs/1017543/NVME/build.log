[2026-11-26T11:46:43.364Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-11-26T11:46:43.364Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-11-26T11:46:43.364Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-11-26T11:46:43.364Z] 
[2026-11-26T11:46:43.364Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-11-26T11:46:43.364Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
