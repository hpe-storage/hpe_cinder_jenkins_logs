[2026-11-26T11:46:43.364Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-11-26T11:46:43.364Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-26T11:46:43.364Z]                         if [ -z "$image_id" ]; then
[2026-11-26T11:46:43.364Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-11-26T11:46:43.364Z]                             exit 1
[2026-11-26T11:46:43.364Z]                         fi
[2026-11-26T11:46:43.364Z]                         echo "image_id: $image_id"
