[2026-11-26T11:46:43.364Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-11-26T11:46:43.364Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-11-26T11:46:43.364Z]                         cd /opt/stack/tempest
[2026-11-26T11:46:43.364Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
