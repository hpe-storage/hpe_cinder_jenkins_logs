[2026-11-20T09:58:00.965Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-20T09:58:00.965Z]                         if [ -z "$image_id" ]; then
