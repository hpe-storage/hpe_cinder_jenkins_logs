[2026-10-09T13:00:34.077Z] 
[2026-10-09T13:00:34.077Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-10-09T13:00:34.077Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-09T13:00:34.077Z]                         if [ -z "$image_id" ]; then
[2026-10-09T13:00:34.077Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-10-09T13:00:34.077Z]                             exit 1
[2026-10-09T13:00:34.077Z]                         fi
[2026-10-09T13:00:34.077Z]                         echo "image_id: $image_id"
[2026-10-09T13:00:34.077Z] 
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_create_get_update_delete_as_clone)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_ebs_image_and_check_boot)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
[2026-10-09T13:00:34.077Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*VolumesExtendTest.test_volume_extend)"
