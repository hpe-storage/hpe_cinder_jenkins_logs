[2026-10-09T12:53:15.122Z]         }
[2026-10-09T12:53:15.122Z]         /^\[.+\]/ {
[2026-10-09T12:53:15.122Z]             gsub("[][]", "", $1);
[2026-10-09T12:53:15.122Z]             section=$1
[2026-10-09T12:53:15.122Z]             next
[2026-10-09T12:53:15.122Z]         }
[2026-10-09T12:53:15.122Z]         /^ *\#/ {
[2026-10-09T12:53:15.122Z]             next
[2026-10-09T12:53:15.122Z]         }
[2026-10-09T12:53:15.122Z]         /^[^ \t]+/ {
[2026-10-09T12:53:15.122Z]             # get offset of first = in $0
[2026-10-09T12:53:15.122Z]             eq_idx = index($0, "=")
[2026-10-09T12:53:15.122Z]             # extract attr & value from $0
[2026-10-09T12:53:15.122Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-09T12:53:15.122Z]             value = substr($0, eq_idx + 1)
[2026-10-09T12:53:15.122Z]             # only need to strip trailing whitespace from attr
[2026-10-09T12:53:15.122Z]             sub(/[ \t]*$/, "", attr)
[2026-10-09T12:53:15.122Z]             # need to strip leading & trailing whitespace from value
[2026-10-09T12:53:15.122Z]             sub(/^[ \t]*/, "", value)
[2026-10-09T12:53:15.122Z]             sub(/[ \t]*$/, "", value)
[2026-10-09T12:53:15.122Z] 
[2026-10-09T12:53:15.122Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-10-09T12:53:15.122Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-10-09T12:53:15.122Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-10-09T12:53:15.122Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-10-09T12:53:15.122Z]             if (! (section, attr) in cfg_attr_count) {
[2026-10-09T12:53:15.122Z]                 if (section != last_section) {
[2026-10-09T12:53:15.122Z]                     cfg_section[section_count++] = section
[2026-10-09T12:53:15.122Z]                     last_section = section
[2026-10-09T12:53:15.122Z]                 }
[2026-10-09T12:53:15.122Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-10-09T12:53:15.122Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-09T12:53:15.122Z] 
[2026-10-09T12:53:15.122Z]                 cfg_attr[section, attr, 0] = value
[2026-10-09T12:53:15.122Z]                 cfg_attr_count[section, attr] = 1
[2026-10-09T12:53:15.122Z]             } else {
[2026-10-09T12:53:15.122Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-09T12:53:15.122Z]                 cfg_attr[section, attr, lno] = value
[2026-10-09T12:53:15.122Z]             }
[2026-10-09T12:53:15.122Z]         }
[2026-10-09T12:53:15.122Z]         END {
[2026-10-09T12:53:15.122Z]             # Process each section in order
[2026-10-09T12:53:15.122Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-09T12:53:15.122Z]                 section = cfg_section[sno]
[2026-10-09T12:53:15.122Z]                 # The ini routines simply append a config item immediately
[2026-10-09T12:53:15.122Z]                 # after the section header. To keep the same order as defined
[2026-10-09T12:53:15.122Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-10-09T12:53:15.122Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-10-09T12:53:15.122Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-10-09T12:53:15.122Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-10-09T12:53:15.122Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-10-09T12:53:15.122Z]                     else {
[2026-10-09T12:53:15.122Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-10-09T12:53:15.123Z]                         count = cfg_attr_count[section, attr]
[2026-10-09T12:53:15.123Z]                         print "inidelete " configfile " " section " " attr
[2026-10-09T12:53:15.123Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-09T12:53:15.123Z]                         for (l = count -2; l >= 0; l--)
[2026-10-09T12:53:15.123Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
