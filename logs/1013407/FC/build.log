[2026-11-01T23:50:48.282Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-01T23:50:48.282Z]                         if [ -z "$image_id" ]; then
[2026-11-01T23:50:48.282Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-11-01T23:50:48.282Z]                             exit 1
[2026-11-01T23:50:48.282Z]                         fi
[2026-11-01T23:50:48.282Z]                         echo "image_id: $image_id"
[2026-11-01T23:50:48.282Z] 
