[2026-11-01T23:52:31.951Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-01T23:52:31.951Z]                         if [ -z "$image_id" ]; then
