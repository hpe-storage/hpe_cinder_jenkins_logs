[2026-10-29T18:17:16.271Z]         /^[^ \t]+/ {
[2026-10-29T18:17:16.271Z]             # get offset of first = in $0
[2026-10-29T18:17:16.271Z]             eq_idx = index($0, "=")
[2026-10-29T18:17:16.271Z]             # extract attr & value from $0
[2026-10-29T18:17:16.271Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-29T18:17:16.271Z]             value = substr($0, eq_idx + 1)
[2026-10-29T18:17:16.271Z]             # only need to strip trailing whitespace from attr
[2026-10-29T18:17:16.271Z]             sub(/[ \t]*$/, "", attr)
[2026-10-29T18:17:16.271Z]             # need to strip leading & trailing whitespace from value
[2026-10-29T18:17:16.271Z]             sub(/^[ \t]*/, "", value)
[2026-10-29T18:17:16.271Z]             sub(/[ \t]*$/, "", value)
