[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-09-22T18:08:33.029Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
