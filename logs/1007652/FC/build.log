[2026-09-28T05:25:30.938Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-09-28T05:25:30.938Z]                         cd /opt/stack/tempest
[2026-09-28T05:25:30.938Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
