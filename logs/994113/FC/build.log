[2026-09-10T17:48:53.232Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-10T17:48:53.232Z]                         if [ -z "$image_id" ]; then
