[2026-09-10T17:48:53.232Z]                             exit 1
[2026-09-10T17:48:53.232Z]                         fi
[2026-09-10T17:48:53.232Z]                         echo "image_id: $image_id"
[2026-09-10T17:48:53.232Z] 
