[2026-09-18T17:07:18.123Z]                         . .tox/tempest/bin/activate
[2026-09-18T17:07:18.123Z]                         export TERM=xterm-256color
[2026-09-18T17:07:18.123Z]                         export OS_TEST_TIMEOUT=3000
[2026-09-18T17:07:18.123Z]                         # Pre-create log file so cp never fails even if tempest exits early
[2026-09-18T17:07:18.123Z]                         touch /opt/stack/logs/tempest_results.log
[2026-09-18T17:07:18.123Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
