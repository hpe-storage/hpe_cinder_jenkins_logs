[2026-10-07T04:38:01.999Z]                 cfg_attr_count[section, attr] = 1
[2026-10-07T04:38:01.999Z]             } else {
[2026-10-07T04:38:01.999Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-07T04:38:01.999Z]                 cfg_attr[section, attr, lno] = value
