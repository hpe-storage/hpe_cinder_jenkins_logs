[2026-10-07T04:38:01.999Z]         END {
[2026-10-07T04:38:01.999Z]             # Process each section in order
[2026-10-07T04:38:01.999Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-07T04:38:01.999Z]                 section = cfg_section[sno]
[2026-10-07T04:38:01.999Z]                 # The ini routines simply append a config item immediately
