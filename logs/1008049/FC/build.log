[2026-10-07T07:45:33.201Z]         BEGIN {
[2026-10-07T07:45:33.201Z]             section = ""
[2026-10-07T07:45:33.201Z]             last_section = ""
[2026-10-07T07:45:33.201Z]             section_count = 0
[2026-10-07T07:45:33.201Z]         }
[2026-10-07T07:45:33.201Z]         /^\[.+\]/ {
[2026-10-07T07:45:33.201Z]             gsub("[][]", "", $1);
[2026-10-07T07:45:33.201Z]             section=$1
[2026-10-07T07:45:33.201Z]             next
[2026-10-07T07:45:33.201Z]         }
[2026-10-07T07:45:33.201Z]         /^ *\#/ {
[2026-10-07T07:45:33.201Z]             next
[2026-10-07T07:45:33.201Z]         }
[2026-10-07T07:45:33.201Z]         /^[^ \t]+/ {
[2026-10-07T07:45:33.201Z]             # get offset of first = in $0
[2026-10-07T07:45:33.201Z]             eq_idx = index($0, "=")
[2026-10-07T07:45:33.201Z]             # extract attr & value from $0
[2026-10-07T07:45:33.201Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-07T07:45:33.201Z]             value = substr($0, eq_idx + 1)
[2026-10-07T07:45:33.201Z]             # only need to strip trailing whitespace from attr
[2026-10-07T07:45:33.201Z]             sub(/[ \t]*$/, "", attr)
[2026-10-07T07:45:33.201Z]             # need to strip leading & trailing whitespace from value
[2026-10-07T07:45:33.201Z]             sub(/^[ \t]*/, "", value)
[2026-10-07T07:45:33.201Z]             sub(/[ \t]*$/, "", value)
[2026-10-07T07:45:33.201Z] 
[2026-10-07T07:45:33.201Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-10-07T07:45:33.201Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-10-07T07:45:33.201Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-10-07T07:45:33.201Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-10-07T07:45:33.201Z]             if (! (section, attr) in cfg_attr_count) {
[2026-10-07T07:45:33.201Z]                 if (section != last_section) {
[2026-10-07T07:45:33.201Z]                     cfg_section[section_count++] = section
[2026-10-07T07:45:33.201Z]                     last_section = section
[2026-10-07T07:45:33.201Z]                 }
[2026-10-07T07:45:33.201Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-10-07T07:45:33.201Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-07T07:45:33.201Z] 
[2026-10-07T07:45:33.201Z]                 cfg_attr[section, attr, 0] = value
[2026-10-07T07:45:33.201Z]                 cfg_attr_count[section, attr] = 1
[2026-10-07T07:45:33.201Z]             } else {
[2026-10-07T07:45:33.201Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-07T07:45:33.201Z]                 cfg_attr[section, attr, lno] = value
[2026-10-07T07:45:33.201Z]             }
[2026-10-07T07:45:33.201Z]         }
[2026-10-07T07:45:33.201Z]         END {
[2026-10-07T07:45:33.201Z]             # Process each section in order
[2026-10-07T07:45:33.201Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-07T07:45:33.201Z]                 section = cfg_section[sno]
[2026-10-07T07:45:33.201Z]                 # The ini routines simply append a config item immediately
[2026-10-07T07:45:33.201Z]                 # after the section header. To keep the same order as defined
[2026-10-07T07:45:33.201Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-10-07T07:45:33.201Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-10-07T07:45:33.201Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-10-07T07:45:33.201Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-10-07T07:45:33.201Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-10-07T07:45:33.201Z]                     else {
[2026-10-07T07:45:33.201Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-10-07T07:45:33.201Z]                         count = cfg_attr_count[section, attr]
[2026-10-07T07:45:33.201Z]                         print "inidelete " configfile " " section " " attr
[2026-10-07T07:45:33.201Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-07T07:45:33.201Z]                         for (l = count -2; l >= 0; l--)
[2026-10-07T07:45:33.201Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-10-07T07:45:33.201Z]                     }
