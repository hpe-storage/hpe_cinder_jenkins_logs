[2026-11-02T18:59:11.872Z]                             exit 1
[2026-11-02T18:59:11.872Z]                         fi
[2026-11-02T18:59:11.872Z]                         echo "image_id: $image_id"
[2026-11-02T18:59:11.872Z] 
