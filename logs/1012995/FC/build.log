[2026-10-30T06:51:12.009Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
