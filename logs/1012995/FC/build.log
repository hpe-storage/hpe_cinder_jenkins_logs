[2026-11-02T18:59:11.872Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-11-02T18:59:11.872Z]                         cd /opt/stack/tempest
[2026-11-02T18:59:11.872Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
