[2026-10-01T09:39:19.334Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-01T09:39:19.334Z]                         if [ -z "$image_id" ]; then
