[2026-11-02T17:12:34.268Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-11-02T17:12:34.268Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-11-02T17:12:34.269Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
