[2026-10-05T08:42:25.474Z]                             exit 1
[2026-10-05T08:42:25.474Z]                         fi
[2026-10-05T08:42:25.474Z]                         echo "image_id: $image_id"
[2026-10-05T08:42:25.474Z] 
