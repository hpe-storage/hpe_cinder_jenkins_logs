[2026-10-01T09:39:19.334Z]                             exit 1
[2026-10-01T09:39:19.334Z]                         fi
[2026-10-01T09:39:19.334Z]                         echo "image_id: $image_id"
[2026-10-01T09:39:19.334Z] 
