[2026-09-03T15:08:55.719Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-03T15:08:55.719Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-09-03T15:08:55.719Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
