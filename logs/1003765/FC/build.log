[2026-09-03T14:04:29.985Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-03T14:04:29.985Z]                         if [ -z "$image_id" ]; then
