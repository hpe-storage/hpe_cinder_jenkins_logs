[2026-09-14T14:44:43.380Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-14T14:44:43.380Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
