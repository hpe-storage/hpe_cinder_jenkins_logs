[2026-09-06T04:38:27.757Z]                             exit 1
[2026-09-06T04:38:27.757Z]                         fi
[2026-09-06T04:38:27.757Z]                         echo "image_id: $image_id"
[2026-09-06T04:38:27.757Z] 
[2026-09-06T04:38:27.757Z]                         # Download FC-specific tempest.conf and skip list
[2026-09-06T04:38:27.757Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-09-06T04:38:27.757Z]                         cd /opt/stack/tempest
[2026-09-06T04:38:27.757Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-06T04:38:27.757Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-09-06T04:38:27.757Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-06T04:38:27.757Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-09-06T04:38:27.757Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-09-06T04:38:27.757Z] 
[2026-09-06T04:38:27.757Z]                         . .tox/tempest/bin/activate
