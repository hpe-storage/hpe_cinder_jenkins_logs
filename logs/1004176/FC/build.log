[2026-09-06T04:38:27.757Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-06T04:38:27.757Z]                         if [ -z "$image_id" ]; then
