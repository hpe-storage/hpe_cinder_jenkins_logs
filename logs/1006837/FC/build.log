[2026-09-22T22:39:40.037Z]                         # Create the public subnet used by Tempest floating IPs (FC range)
[2026-09-22T22:39:40.037Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-09-22T22:39:40.037Z] 
[2026-09-22T22:39:40.037Z]                         # Extract image_id from the DevStack-generated tempest.conf before overwriting it
[2026-09-22T22:39:40.037Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-22T22:39:40.037Z]                         if [ -z "$image_id" ]; then
[2026-09-22T22:39:40.037Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-09-22T22:39:40.037Z]                             exit 1
[2026-09-22T22:39:40.037Z]                         fi
[2026-09-22T22:39:40.037Z]                         echo "image_id: $image_id"
[2026-09-22T22:39:40.037Z] 
[2026-09-22T22:39:40.037Z]                         # Download FC-specific tempest.conf and skip list
[2026-09-22T22:39:40.038Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-09-22T22:39:40.038Z]                         cd /opt/stack/tempest
[2026-09-22T22:39:40.038Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-22T22:39:40.038Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-09-22T22:39:40.038Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-22T22:39:40.038Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-09-22T22:39:40.038Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-09-22T22:39:40.038Z] 
[2026-09-22T22:39:40.038Z]                         . .tox/tempest/bin/activate
[2026-09-22T22:39:40.038Z]                         export TERM=xterm-256color
[2026-09-22T22:39:40.038Z]                         export OS_TEST_TIMEOUT=3000
[2026-09-22T22:39:40.038Z]                         # Pre-create log file so cp never fails even if tempest exits early
[2026-09-22T22:39:40.038Z]                         touch /opt/stack/logs/tempest_results.log
[2026-09-22T22:39:40.038Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
