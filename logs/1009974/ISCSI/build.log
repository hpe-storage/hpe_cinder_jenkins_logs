[2026-10-12T12:33:32.082Z]                     last_section = section
[2026-10-12T12:33:32.082Z]                 }
[2026-10-12T12:33:32.082Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-10-12T12:33:32.083Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-12T12:33:32.083Z] 
[2026-10-12T12:33:32.083Z]                 cfg_attr[section, attr, 0] = value
[2026-10-12T12:33:32.083Z]                 cfg_attr_count[section, attr] = 1
[2026-10-12T12:33:32.083Z]             } else {
[2026-10-12T12:33:32.083Z]                 lno = cfg_attr_count[section, attr]++
[2026-10-12T12:33:32.083Z]                 cfg_attr[section, attr, lno] = value
[2026-10-12T12:33:32.083Z]             }
[2026-10-12T12:33:32.083Z]         }
[2026-10-12T12:33:32.083Z]         END {
[2026-10-12T12:33:32.083Z]             # Process each section in order
[2026-10-12T12:33:32.083Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-12T12:33:32.083Z]                 section = cfg_section[sno]
[2026-10-12T12:33:32.083Z]                 # The ini routines simply append a config item immediately
[2026-10-12T12:33:32.083Z]                 # after the section header. To keep the same order as defined
[2026-10-12T12:33:32.083Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-10-12T12:33:32.083Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-10-12T12:33:32.083Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-10-12T12:33:32.083Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-10-12T12:33:32.083Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-10-12T12:33:32.083Z]                     else {
