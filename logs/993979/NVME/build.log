[2026-09-03T13:14:26.511Z]                         # Create public subnet for Tempest floating IPs (NVMe/TCP range from gate.sh)
[2026-09-03T13:14:26.511Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-09-03T13:14:26.511Z] 
[2026-09-03T13:14:26.511Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-09-03T13:14:26.511Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-03T13:14:26.511Z]                         if [ -z "$image_id" ]; then
[2026-09-03T13:14:26.511Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-09-03T13:14:26.511Z]                             exit 1
[2026-09-03T13:14:26.511Z]                         fi
[2026-09-03T13:14:26.511Z]                         echo "image_id: $image_id"
[2026-09-03T13:14:26.511Z] 
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_create_get_update_delete_as_clone)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_ebs_image_and_check_boot)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*VolumesExtendTest.test_volume_extend)"
[2026-09-03T13:14:26.511Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_snapshot_create_delete_with_volume_in_use)"
[2026-09-03T13:14:26.511Z] 
[2026-09-03T13:14:26.511Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-09-03T13:14:26.511Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-03T13:14:26.511Z]                         cd /opt/stack/tempest
[2026-09-03T13:14:26.511Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-03T13:14:26.511Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/tempest.conf -P /opt/stack/tempest/etc/
[2026-09-03T13:14:26.511Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-03T13:14:26.511Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-09-03T13:14:26.511Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-09-03T13:14:26.511Z] 
[2026-09-03T13:14:26.511Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-03T13:14:26.511Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
[2026-09-03T13:14:26.511Z] 
[2026-09-03T13:14:26.511Z]                         . .tox/tempest/bin/activate
[2026-09-03T13:14:26.511Z]                         export TERM=xterm-256color
[2026-09-03T13:14:26.511Z]                         export OS_TEST_TIMEOUT=3000
[2026-09-03T13:14:26.511Z]                         # Pre-create log file so cp never fails even if tempest exits early
[2026-09-03T13:14:26.511Z]                         touch /opt/stack/logs/tempest_results.log
[2026-09-03T13:14:26.511Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
