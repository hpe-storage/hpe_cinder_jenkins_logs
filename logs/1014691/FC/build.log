[2026-11-08T12:28:37.668Z]                             exit 1
[2026-11-08T12:28:37.668Z]                         fi
[2026-11-08T12:28:37.668Z]                         echo "image_id: $image_id"
[2026-11-08T12:28:37.668Z] 
