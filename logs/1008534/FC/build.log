[2026-10-12T21:41:45.784Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-10-12T21:41:45.784Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-10-12T21:41:45.784Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-10-12T21:41:45.784Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-10-12T21:41:45.784Z]             if (! (section, attr) in cfg_attr_count) {
[2026-10-12T21:41:45.784Z]                 if (section != last_section) {
[2026-10-12T21:41:45.784Z]                     cfg_section[section_count++] = section
[2026-10-12T21:41:45.784Z]                     last_section = section
[2026-10-12T21:41:45.784Z]                 }
