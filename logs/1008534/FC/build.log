[2026-10-12T21:41:45.784Z]         END {
[2026-10-12T21:41:45.784Z]             # Process each section in order
[2026-10-12T21:41:45.784Z]             for (sno = 0; sno < section_count; sno++) {
[2026-10-12T21:41:45.784Z]                 section = cfg_section[sno]
[2026-10-12T21:41:45.784Z]                 # The ini routines simply append a config item immediately
[2026-10-12T21:41:45.784Z]                 # after the section header. To keep the same order as defined
[2026-10-12T21:41:45.784Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-10-12T21:41:45.784Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
