[2026-10-12T21:41:45.784Z]         }
[2026-10-12T21:41:45.784Z]         /^ *\#/ {
[2026-10-12T21:41:45.784Z]             next
[2026-10-12T21:41:45.784Z]         }
[2026-10-12T21:41:45.784Z]         /^[^ \t]+/ {
[2026-10-12T21:41:45.784Z]             # get offset of first = in $0
[2026-10-12T21:41:45.784Z]             eq_idx = index($0, "=")
[2026-10-12T21:41:45.784Z]             # extract attr & value from $0
[2026-10-12T21:41:45.784Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-12T21:41:45.784Z]             value = substr($0, eq_idx + 1)
[2026-10-12T21:41:45.784Z]             # only need to strip trailing whitespace from attr
[2026-10-12T21:41:45.784Z]             sub(/[ \t]*$/, "", attr)
[2026-10-12T21:41:45.784Z]             # need to strip leading & trailing whitespace from value
[2026-10-12T21:41:45.784Z]             sub(/^[ \t]*/, "", value)
[2026-10-12T21:41:45.784Z]             sub(/[ \t]*$/, "", value)
