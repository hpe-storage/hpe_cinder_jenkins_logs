[2026-10-12T21:41:45.784Z]                         print "inidelete " configfile " " section " " attr
[2026-10-12T21:41:45.784Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-12T21:41:45.784Z]                         for (l = count -2; l >= 0; l--)
[2026-10-12T21:41:45.784Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
