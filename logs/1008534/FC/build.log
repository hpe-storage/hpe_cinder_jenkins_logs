[2026-10-12T21:41:45.784Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-10-12T21:41:45.784Z] 
[2026-10-12T21:41:45.784Z]                 cfg_attr[section, attr, 0] = value
[2026-10-12T21:41:45.784Z]                 cfg_attr_count[section, attr] = 1
[2026-10-12T21:41:45.784Z]             } else {
[2026-10-12T21:41:45.784Z]                 lno = cfg_attr_count[section, attr]++
