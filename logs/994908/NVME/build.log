[2026-09-09T01:55:41.229Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-09T01:55:41.229Z]                         if [ -z "$image_id" ]; then
