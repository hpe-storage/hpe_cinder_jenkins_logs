[2026-11-17T20:18:37.273Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-17T20:18:37.273Z]                         if [ -z "$image_id" ]; then
