[2026-09-04T14:45:33.602Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-04T14:45:33.602Z]                         cd /opt/stack/tempest
[2026-09-04T14:45:33.602Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-04T14:45:33.602Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/tempest.conf -P /opt/stack/tempest/etc/
[2026-09-04T14:45:33.602Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-04T14:45:33.602Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-09-04T14:45:33.602Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-09-04T14:45:33.602Z] 
[2026-09-04T14:45:33.602Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-04T14:45:33.602Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
