[2026-09-04T14:45:33.602Z]                         export OS_TEST_TIMEOUT=3000
[2026-09-04T14:45:33.603Z]                         # Pre-create log file so cp never fails even if tempest exits early
[2026-09-04T14:45:33.603Z]                         touch /opt/stack/logs/tempest_results.log
[2026-09-04T14:45:33.603Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
