[2026-11-24T02:21:06.909Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-24T02:21:06.909Z]                         if [ -z "$image_id" ]; then
[2026-11-24T02:21:06.909Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-11-24T02:21:06.909Z]                             exit 1
[2026-11-24T02:21:06.909Z]                         fi
[2026-11-24T02:21:06.909Z]                         echo "image_id: $image_id"
[2026-11-24T02:21:06.909Z] 
