[2026-11-23T14:03:48.988Z]                         print "inidelete " configfile " " section " " attr
[2026-11-23T14:03:48.988Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-23T14:03:48.988Z]                         for (l = count -2; l >= 0; l--)
[2026-11-23T14:03:48.988Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
