[2026-11-23T14:03:48.988Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-11-23T14:03:48.988Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-11-23T14:03:48.988Z]             if (! (section, attr) in cfg_attr_count) {
