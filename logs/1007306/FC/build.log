[2026-10-07T09:57:04.225Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-07T09:57:04.225Z]                         if [ -z "$image_id" ]; then
[2026-10-07T09:57:04.225Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-10-07T09:57:04.225Z]                             exit 1
[2026-10-07T09:57:04.225Z]                         fi
[2026-10-07T09:57:04.225Z]                         echo "image_id: $image_id"
[2026-10-07T09:57:04.225Z] 
