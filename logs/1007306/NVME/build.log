[2026-10-07T10:01:20.404Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-10-07T10:01:20.404Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-10-07T10:01:20.404Z]                         cd /opt/stack/tempest
[2026-10-07T10:01:20.404Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
