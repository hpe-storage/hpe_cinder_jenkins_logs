[2026-10-07T10:01:20.404Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-10-07T10:01:20.404Z] 
[2026-10-07T10:01:20.404Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-10-07T10:01:20.404Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-07T10:01:20.404Z]                         if [ -z "$image_id" ]; then
[2026-10-07T10:01:20.404Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-10-07T10:01:20.404Z]                             exit 1
[2026-10-07T10:01:20.404Z]                         fi
[2026-10-07T10:01:20.404Z]                         echo "image_id: $image_id"
