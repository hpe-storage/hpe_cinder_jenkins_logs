[2026-11-03T08:29:47.324Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-03T08:29:47.324Z]                         if [ -z "$image_id" ]; then
