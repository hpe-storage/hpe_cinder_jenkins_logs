[2026-10-15T14:54:00.602Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-10-15T14:54:00.602Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-10-15T14:54:00.602Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
