[2026-10-15T14:54:00.602Z]                             exit 1
[2026-10-15T14:54:00.602Z]                         fi
[2026-10-15T14:54:00.602Z]                         echo "image_id: $image_id"
[2026-10-15T14:54:00.602Z] 
