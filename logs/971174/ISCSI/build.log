[2026-10-31T20:51:04.515Z]                         print "inidelete " configfile " " section " " attr
[2026-10-31T20:51:04.515Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-31T20:51:04.515Z]                         for (l = count -2; l >= 0; l--)
[2026-10-31T20:51:04.515Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-10-31T20:51:04.515Z]                     }
[2026-10-31T20:51:04.515Z]                 }
[2026-10-31T20:51:04.515Z]             }
