[2026-10-31T20:51:04.514Z]                 section = cfg_section[sno]
[2026-10-31T20:51:04.515Z]                 # The ini routines simply append a config item immediately
[2026-10-31T20:51:04.515Z]                 # after the section header. To keep the same order as defined
