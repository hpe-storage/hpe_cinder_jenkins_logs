[2026-10-31T20:51:04.515Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-10-31T20:51:04.515Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-10-31T20:51:04.515Z]                     else {
