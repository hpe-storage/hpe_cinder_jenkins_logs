[2026-10-02T17:24:33.074Z]         /^ *\#/ {
[2026-10-02T17:24:33.074Z]             next
[2026-10-02T17:24:33.074Z]         }
[2026-10-02T17:24:33.074Z]         /^[^ \t]+/ {
[2026-10-02T17:24:33.074Z]             # get offset of first = in $0
[2026-10-02T17:24:33.074Z]             eq_idx = index($0, "=")
[2026-10-02T17:24:33.074Z]             # extract attr & value from $0
[2026-10-02T17:24:33.074Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-02T17:24:33.074Z]             value = substr($0, eq_idx + 1)
[2026-10-02T17:24:33.074Z]             # only need to strip trailing whitespace from attr
[2026-10-02T17:24:33.074Z]             sub(/[ \t]*$/, "", attr)
[2026-10-02T17:24:33.074Z]             # need to strip leading & trailing whitespace from value
[2026-10-02T17:24:33.074Z]             sub(/^[ \t]*/, "", value)
[2026-10-02T17:24:33.074Z]             sub(/[ \t]*$/, "", value)
