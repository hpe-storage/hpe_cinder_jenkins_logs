[2026-10-02T17:24:33.074Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-10-02T17:24:33.074Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-10-02T17:24:33.074Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-10-02T17:24:33.074Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
