[2026-11-16T08:50:08.819Z]         /^ *\#/ {
[2026-11-16T08:50:08.819Z]             next
[2026-11-16T08:50:08.819Z]         }
[2026-11-16T08:50:08.819Z]         /^[^ \t]+/ {
[2026-11-16T08:50:08.819Z]             # get offset of first = in $0
[2026-11-16T08:50:08.819Z]             eq_idx = index($0, "=")
[2026-11-16T08:50:08.819Z]             # extract attr & value from $0
[2026-11-16T08:50:08.819Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-16T08:50:08.819Z]             value = substr($0, eq_idx + 1)
[2026-11-16T08:50:08.819Z]             # only need to strip trailing whitespace from attr
[2026-11-16T08:50:08.819Z]             sub(/[ \t]*$/, "", attr)
[2026-11-16T08:50:08.819Z]             # need to strip leading & trailing whitespace from value
[2026-11-16T08:50:08.819Z]             sub(/^[ \t]*/, "", value)
[2026-11-16T08:50:08.819Z]             sub(/[ \t]*$/, "", value)
