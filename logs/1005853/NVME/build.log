[2026-11-16T08:50:08.820Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-16T08:50:08.820Z]                         for (l = count -2; l >= 0; l--)
[2026-11-16T08:50:08.820Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-11-16T08:50:08.820Z]                     }
[2026-11-16T08:50:08.820Z]                 }
