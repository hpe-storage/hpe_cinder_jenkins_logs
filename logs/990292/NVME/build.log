[2026-09-02T09:22:53.820Z] 
[2026-09-02T09:22:53.820Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-02T09:22:53.820Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
