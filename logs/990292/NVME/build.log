[2026-09-04T10:20:11.790Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-09-04T10:20:11.790Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-04T10:20:11.790Z]                         if [ -z "$image_id" ]; then
[2026-09-04T10:20:11.790Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-09-04T10:20:11.790Z]                             exit 1
[2026-09-04T10:20:11.790Z]                         fi
[2026-09-04T10:20:11.790Z]                         echo "image_id: $image_id"
