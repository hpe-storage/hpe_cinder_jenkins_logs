[2026-11-26T07:43:29.513Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-11-26T07:43:29.513Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-26T07:43:29.513Z]                         if [ -z "$image_id" ]; then
[2026-11-26T07:43:29.513Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-11-26T07:43:29.513Z]                             exit 1
