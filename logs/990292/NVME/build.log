[2026-09-02T09:22:53.820Z]                         . .tox/tempest/bin/activate
[2026-09-02T09:22:53.820Z]                         export TERM=xterm-256color
[2026-09-02T09:22:53.820Z]                         export OS_TEST_TIMEOUT=3000
