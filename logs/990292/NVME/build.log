[2026-09-04T13:29:37.857Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-04T13:29:37.857Z]                         cd /opt/stack/tempest
[2026-09-04T13:29:37.857Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-04T13:29:37.857Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/tempest.conf -P /opt/stack/tempest/etc/
[2026-09-04T13:29:37.858Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-04T13:29:37.858Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-09-04T13:29:37.858Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-09-04T13:29:37.858Z] 
[2026-09-04T13:29:37.858Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-04T13:29:37.858Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
[2026-09-04T13:29:37.858Z] 
[2026-09-04T13:29:37.858Z]                         . .tox/tempest/bin/activate
[2026-09-04T13:29:37.858Z]                         export TERM=xterm-256color
[2026-09-04T13:29:37.858Z]                         export OS_TEST_TIMEOUT=3000
[2026-09-04T13:29:37.858Z]                         # Pre-create log file so cp never fails even if tempest exits early
[2026-09-04T13:29:37.858Z]                         touch /opt/stack/logs/tempest_results.log
[2026-09-04T13:29:37.858Z]                         tempest run                             --regex "^(?=.*volume|(^cinder_tempest_plugin))"                             --blacklist-file /opt/stack/tempest/skip.txt                             --concurrency=1 | tee /opt/stack/logs/tempest_results.log || true
