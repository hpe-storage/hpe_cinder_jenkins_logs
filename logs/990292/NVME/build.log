[2026-09-02T09:22:53.820Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-09-02T09:22:53.820Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-02T09:22:53.820Z]                         cd /opt/stack/tempest
[2026-09-02T09:22:53.820Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-09-02T09:22:53.820Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/tempest.conf -P /opt/stack/tempest/etc/
[2026-09-02T09:22:53.820Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-02T09:22:53.820Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
