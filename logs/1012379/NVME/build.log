[2026-10-27T00:47:58.530Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-27T00:47:58.530Z]                         if [ -z "$image_id" ]; then
