                        set -ex
                         HOST_IP=$(hostname -I | cut -d" " -f1)
                        export no_proxy=${no_proxy:-},localhost,127.0.0.1,${HOST_IP}
                        . /opt/stack/devstack/openrc admin admin
                        openstack volume service list

                        VOL_ID=$(openstack volume create --size 1 --type 3par1 ci-test-vol -f value -c id)
                        echo "Created volume: $VOL_ID"

                        for i in $(seq 1 30); do
                            STATUS=$(openstack volume show "$VOL_ID" -f value -c status)
                            echo "Volume status: $STATUS (attempt $i/30)"
                            if [ "$STATUS" = "available" ]; then
                                break
                            elif [ "$STATUS" = "error" ]; then
                                echo "Volume creation failed!"
                                openstack volume show "$VOL_ID"
                                exit 1
                            fi
                            sleep 10
                        done

                        openstack volume show "$VOL_ID"
                        openstack volume delete "$VOL_ID"
                        echo "Smoke test passed."
                    
