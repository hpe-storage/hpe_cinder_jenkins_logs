[2026-11-20T14:08:08.245Z]         /^[^ \t]+/ {
[2026-11-20T14:08:08.245Z]             # get offset of first = in $0
[2026-11-20T14:08:08.245Z]             eq_idx = index($0, "=")
[2026-11-20T14:08:08.245Z]             # extract attr & value from $0
[2026-11-20T14:08:08.245Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-20T14:08:08.245Z]             value = substr($0, eq_idx + 1)
[2026-11-20T14:08:08.245Z]             # only need to strip trailing whitespace from attr
[2026-11-20T14:08:08.245Z]             sub(/[ \t]*$/, "", attr)
[2026-11-20T14:08:08.245Z]             # need to strip leading & trailing whitespace from value
