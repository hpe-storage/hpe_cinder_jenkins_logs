[2026-09-07T11:22:37.039Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-07T11:22:37.039Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
