[2026-11-24T13:59:07.376Z]                             exit 1
[2026-11-24T13:59:07.376Z]                         fi
[2026-11-24T13:59:07.376Z]                         echo "image_id: $image_id"
[2026-11-24T13:59:07.376Z] 
