[2026-10-27T14:07:35.302Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-10-27T14:07:35.302Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-10-27T14:07:35.302Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-10-27T14:07:35.302Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-10-27T14:07:35.302Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
