[2026-11-03T12:11:29.650Z]         BEGIN {
[2026-11-03T12:11:29.650Z]             section = ""
[2026-11-03T12:11:29.650Z]             last_section = ""
[2026-11-03T12:11:29.650Z]             section_count = 0
[2026-11-03T12:11:29.650Z]         }
[2026-11-03T12:11:29.650Z]         /^\[.+\]/ {
[2026-11-03T12:11:29.650Z]             gsub("[][]", "", $1);
[2026-11-03T12:11:29.650Z]             section=$1
[2026-11-03T12:11:29.650Z]             next
[2026-11-03T12:11:29.650Z]         }
[2026-11-03T12:11:29.650Z]         /^ *\#/ {
[2026-11-03T12:11:29.650Z]             next
[2026-11-03T12:11:29.650Z]         }
[2026-11-03T12:11:29.650Z]         /^[^ \t]+/ {
[2026-11-03T12:11:29.650Z]             # get offset of first = in $0
[2026-11-03T12:11:29.651Z]             eq_idx = index($0, "=")
[2026-11-03T12:11:29.651Z]             # extract attr & value from $0
[2026-11-03T12:11:29.651Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-03T12:11:29.651Z]             value = substr($0, eq_idx + 1)
[2026-11-03T12:11:29.651Z]             # only need to strip trailing whitespace from attr
[2026-11-03T12:11:29.651Z]             sub(/[ \t]*$/, "", attr)
[2026-11-03T12:11:29.651Z]             # need to strip leading & trailing whitespace from value
[2026-11-03T12:11:29.651Z]             sub(/^[ \t]*/, "", value)
[2026-11-03T12:11:29.651Z]             sub(/[ \t]*$/, "", value)
[2026-11-03T12:11:29.651Z] 
[2026-11-03T12:11:29.651Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-11-03T12:11:29.651Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-11-03T12:11:29.651Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-11-03T12:11:29.651Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-11-03T12:11:29.651Z]             if (! (section, attr) in cfg_attr_count) {
[2026-11-03T12:11:29.651Z]                 if (section != last_section) {
[2026-11-03T12:11:29.651Z]                     cfg_section[section_count++] = section
[2026-11-03T12:11:29.651Z]                     last_section = section
[2026-11-03T12:11:29.651Z]                 }
[2026-11-03T12:11:29.651Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-11-03T12:11:29.651Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-11-03T12:11:29.651Z] 
[2026-11-03T12:11:29.651Z]                 cfg_attr[section, attr, 0] = value
[2026-11-03T12:11:29.651Z]                 cfg_attr_count[section, attr] = 1
[2026-11-03T12:11:29.651Z]             } else {
[2026-11-03T12:11:29.651Z]                 lno = cfg_attr_count[section, attr]++
[2026-11-03T12:11:29.651Z]                 cfg_attr[section, attr, lno] = value
[2026-11-03T12:11:29.652Z]             }
[2026-11-03T12:11:29.652Z]         }
[2026-11-03T12:11:29.652Z]         END {
[2026-11-03T12:11:29.652Z]             # Process each section in order
[2026-11-03T12:11:29.652Z]             for (sno = 0; sno < section_count; sno++) {
[2026-11-03T12:11:29.652Z]                 section = cfg_section[sno]
[2026-11-03T12:11:29.652Z]                 # The ini routines simply append a config item immediately
[2026-11-03T12:11:29.652Z]                 # after the section header. To keep the same order as defined
[2026-11-03T12:11:29.652Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-11-03T12:11:29.652Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-11-03T12:11:29.652Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-11-03T12:11:29.652Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-11-03T12:11:29.652Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-11-03T12:11:29.652Z]                     else {
[2026-11-03T12:11:29.652Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-11-03T12:11:29.652Z]                         count = cfg_attr_count[section, attr]
[2026-11-03T12:11:29.652Z]                         print "inidelete " configfile " " section " " attr
[2026-11-03T12:11:29.652Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-03T12:11:29.652Z]                         for (l = count -2; l >= 0; l--)
[2026-11-03T12:11:29.652Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-11-03T12:11:29.652Z]                     }
