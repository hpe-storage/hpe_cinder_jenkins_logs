[2026-09-24T10:19:32.516Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-24T10:19:32.516Z]                         if [ -z "$image_id" ]; then
