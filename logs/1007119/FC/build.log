[2026-09-24T10:19:32.516Z]                             exit 1
[2026-09-24T10:19:32.516Z]                         fi
[2026-09-24T10:19:32.516Z]                         echo "image_id: $image_id"
[2026-09-24T10:19:32.516Z] 
