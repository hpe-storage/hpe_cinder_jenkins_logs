[2026-09-21T16:28:33.225Z]                             exit 1
[2026-09-21T16:28:33.225Z]                         fi
[2026-09-21T16:28:33.225Z]                         echo "image_id: $image_id"
[2026-09-21T16:28:33.225Z] 
