[2026-09-23T20:53:47.785Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-09-23T20:53:47.785Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-23T20:53:47.785Z]                         if [ -z "$image_id" ]; then
