[2026-11-16T05:40:11.975Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-16T05:40:11.975Z]                         if [ -z "$image_id" ]; then
