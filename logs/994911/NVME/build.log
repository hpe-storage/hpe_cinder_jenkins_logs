[2026-10-12T16:59:38.936Z]                     else {
[2026-10-12T16:59:38.936Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-10-12T16:59:38.936Z]                         count = cfg_attr_count[section, attr]
[2026-10-12T16:59:38.936Z]                         print "inidelete " configfile " " section " " attr
[2026-10-12T16:59:38.936Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-10-12T16:59:38.936Z]                         for (l = count -2; l >= 0; l--)
