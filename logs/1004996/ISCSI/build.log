[2026-09-23T08:34:07.579Z]         /^[^ \t]+/ {
[2026-09-23T08:34:07.579Z]             # get offset of first = in $0
[2026-09-23T08:34:07.579Z]             eq_idx = index($0, "=")
[2026-09-23T08:34:07.579Z]             # extract attr & value from $0
