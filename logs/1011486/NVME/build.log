[2026-10-20T15:15:08.824Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-20T15:15:08.824Z]                         if [ -z "$image_id" ]; then
