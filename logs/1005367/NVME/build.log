[2026-09-12T05:10:10.174Z]         /^ *\#/ {
[2026-09-12T05:10:10.174Z]             next
[2026-09-12T05:10:10.174Z]         }
[2026-09-12T05:10:10.174Z]         /^[^ \t]+/ {
[2026-09-12T05:10:10.174Z]             # get offset of first = in $0
[2026-09-12T05:10:10.174Z]             eq_idx = index($0, "=")
[2026-09-12T05:10:10.174Z]             # extract attr & value from $0
[2026-09-12T05:10:10.174Z]             attr = substr($0, 1, eq_idx - 1)
[2026-09-12T05:10:10.174Z]             value = substr($0, eq_idx + 1)
[2026-09-12T05:10:10.175Z]             # only need to strip trailing whitespace from attr
[2026-09-12T05:10:10.175Z]             sub(/[ \t]*$/, "", attr)
[2026-09-12T05:10:10.175Z]             # need to strip leading & trailing whitespace from value
[2026-09-12T05:10:10.175Z]             sub(/^[ \t]*/, "", value)
