[2026-10-06T16:43:26.659Z]                                 openstack volume show "$VOL_ID"
[2026-10-06T16:43:26.659Z]                                 exit 1
[2026-10-06T16:43:26.659Z]                             fi
[2026-10-06T16:43:26.659Z]                             sleep 10
[2026-10-06T16:43:26.659Z]                         done
