[2026-11-17T05:06:00.450Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-11-17T05:06:00.450Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-11-17T05:06:00.450Z]                         cd /opt/stack/tempest
[2026-11-17T05:06:00.450Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
