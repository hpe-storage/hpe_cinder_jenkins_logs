[2026-11-17T05:06:00.450Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-11-17T05:06:00.450Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-11-17T05:06:00.450Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-11-17T05:06:00.450Z] 
