[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_ebs_image_and_check_boot)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
[2026-11-17T05:06:00.450Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*VolumesExtendTest.test_volume_extend)"
