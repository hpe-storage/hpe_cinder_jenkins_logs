[2026-11-19T16:26:35.254Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-11-19T16:26:35.254Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-11-19T16:26:35.254Z]                     else {
[2026-11-19T16:26:35.254Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-11-19T16:26:35.254Z]                         count = cfg_attr_count[section, attr]
[2026-11-19T16:26:35.254Z]                         print "inidelete " configfile " " section " " attr
[2026-11-19T16:26:35.254Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-19T16:26:35.254Z]                         for (l = count -2; l >= 0; l--)
[2026-11-19T16:26:35.254Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-11-19T16:26:35.254Z]                     }
[2026-11-19T16:26:35.254Z]                 }
[2026-11-19T16:26:35.254Z]             }
