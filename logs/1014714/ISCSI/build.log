[2026-11-19T16:26:35.253Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-11-19T16:26:35.253Z]             if (! (section, attr) in cfg_attr_count) {
[2026-11-19T16:26:35.253Z]                 if (section != last_section) {
