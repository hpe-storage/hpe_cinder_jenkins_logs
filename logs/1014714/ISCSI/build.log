[2026-11-19T16:26:35.254Z]                 section = cfg_section[sno]
[2026-11-19T16:26:35.254Z]                 # The ini routines simply append a config item immediately
[2026-11-19T16:26:35.254Z]                 # after the section header. To keep the same order as defined
