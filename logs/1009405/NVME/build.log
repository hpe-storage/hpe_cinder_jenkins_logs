[2026-10-27T05:56:24.850Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-10-27T05:56:24.850Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-10-27T05:56:24.850Z]                         if [ -z "$image_id" ]; then
[2026-10-27T05:56:24.850Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-10-27T05:56:24.850Z]                             exit 1
[2026-10-27T05:56:24.850Z]                         fi
[2026-10-27T05:56:24.850Z]                         echo "image_id: $image_id"
