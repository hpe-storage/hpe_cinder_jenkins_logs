[2026-11-18T01:52:08.393Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-11-18T01:52:08.393Z] 
[2026-11-18T01:52:08.393Z]                         # Extract image_id from the DevStack-generated tempest.conf before overwriting it
[2026-11-18T01:52:08.393Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-18T01:52:08.393Z]                         if [ -z "$image_id" ]; then
[2026-11-18T01:52:08.393Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-11-18T01:52:08.393Z]                             exit 1
[2026-11-18T01:52:08.393Z]                         fi
[2026-11-18T01:52:08.393Z]                         echo "image_id: $image_id"
[2026-11-18T01:52:08.393Z] 
[2026-11-18T01:52:08.393Z]                         # Download FC-specific tempest.conf and skip list
[2026-11-18T01:52:08.393Z]                         sudo wget --no-proxy http://10.132.239.244/fc/skip.txt      -P /opt/stack/tempest/
[2026-11-18T01:52:08.393Z]                         cd /opt/stack/tempest
[2026-11-18T01:52:08.393Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-11-18T01:52:08.393Z]                         sudo wget --no-proxy http://10.132.239.244/fc/tempest.conf  -P /opt/stack/tempest/etc/
[2026-11-18T01:52:08.393Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-11-18T01:52:08.393Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"        /opt/stack/tempest/etc/tempest.conf
[2026-11-18T01:52:08.393Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-11-18T01:52:08.393Z] 
[2026-11-18T01:52:08.393Z]                         . .tox/tempest/bin/activate
[2026-11-18T01:52:08.393Z]                         export TERM=xterm-256color
[2026-11-18T01:52:08.393Z]                         export OS_TEST_TIMEOUT=3000
[2026-11-18T01:52:08.393Z]                         # Pre-create log file so cp never fails even if tempest exits early
