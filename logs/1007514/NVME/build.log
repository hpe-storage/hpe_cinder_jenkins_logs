[2026-09-25T17:50:00.925Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-09-25T17:50:00.925Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-25T17:50:00.925Z]                         cd /opt/stack/tempest
[2026-09-25T17:50:00.925Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
