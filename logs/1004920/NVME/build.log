[2026-09-09T19:42:20.686Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-09T19:42:20.686Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
