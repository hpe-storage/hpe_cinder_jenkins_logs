[2026-09-28T19:50:54.102Z] 
[2026-09-28T19:50:54.102Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-28T19:50:54.102Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
