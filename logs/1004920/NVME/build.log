[2026-09-09T19:42:20.686Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-09T19:42:20.686Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
