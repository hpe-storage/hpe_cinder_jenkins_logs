[2026-11-14T09:07:00.409Z]                             exit 1
[2026-11-14T09:07:00.409Z]                         fi
[2026-11-14T09:07:00.409Z]                         echo "image_id: $image_id"
[2026-11-14T09:07:00.409Z] 
