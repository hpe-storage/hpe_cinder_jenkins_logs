[2026-11-14T09:07:00.409Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-11-14T09:07:00.409Z]                         if [ -z "$image_id" ]; then
