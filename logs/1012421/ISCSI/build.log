[2026-11-23T05:24:53.765Z]         /^[^ \t]+/ {
[2026-11-23T05:24:53.765Z]             # get offset of first = in $0
[2026-11-23T05:24:53.765Z]             eq_idx = index($0, "=")
[2026-11-23T05:24:53.765Z]             # extract attr & value from $0
[2026-11-23T05:24:53.765Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-23T05:24:53.765Z]             value = substr($0, eq_idx + 1)
[2026-11-23T05:24:53.765Z]             # only need to strip trailing whitespace from attr
[2026-11-23T05:24:53.765Z]             sub(/[ \t]*$/, "", attr)
[2026-11-23T05:24:53.765Z]             # need to strip leading & trailing whitespace from value
