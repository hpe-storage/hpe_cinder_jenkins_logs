[2026-10-27T04:51:51.368Z]         /^ *\#/ {
[2026-10-27T04:51:51.368Z]             next
[2026-10-27T04:51:51.368Z]         }
[2026-10-27T04:51:51.368Z]         /^[^ \t]+/ {
[2026-10-27T04:51:51.368Z]             # get offset of first = in $0
[2026-10-27T04:51:51.368Z]             eq_idx = index($0, "=")
[2026-10-27T04:51:51.368Z]             # extract attr & value from $0
[2026-10-27T04:51:51.368Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-27T04:51:51.368Z]             value = substr($0, eq_idx + 1)
[2026-10-27T04:51:51.368Z]             # only need to strip trailing whitespace from attr
[2026-10-27T04:51:51.368Z]             sub(/[ \t]*$/, "", attr)
[2026-10-27T04:51:51.368Z]             # need to strip leading & trailing whitespace from value
[2026-10-27T04:51:51.368Z]             sub(/^[ \t]*/, "", value)
