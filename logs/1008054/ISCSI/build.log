[2026-11-04T11:59:09.274Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-11-04T11:59:09.274Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-11-04T11:59:09.274Z]                     else {
[2026-11-04T11:59:09.274Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-11-04T11:59:09.274Z]                         count = cfg_attr_count[section, attr]
[2026-11-04T11:59:09.274Z]                         print "inidelete " configfile " " section " " attr
[2026-11-04T11:59:09.274Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-11-04T11:59:09.274Z]                         for (l = count -2; l >= 0; l--)
[2026-11-04T11:59:09.274Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-11-04T11:59:09.274Z]                     }
[2026-11-04T11:59:09.274Z]                 }
[2026-11-04T11:59:09.274Z]             }
