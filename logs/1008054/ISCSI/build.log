[2026-11-04T11:59:09.273Z]         END {
[2026-11-04T11:59:09.273Z]             # Process each section in order
[2026-11-04T11:59:09.274Z]             for (sno = 0; sno < section_count; sno++) {
[2026-11-04T11:59:09.274Z]                 section = cfg_section[sno]
[2026-11-04T11:59:09.274Z]                 # The ini routines simply append a config item immediately
[2026-11-04T11:59:09.274Z]                 # after the section header. To keep the same order as defined
[2026-11-04T11:59:09.274Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-11-04T11:59:09.274Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
