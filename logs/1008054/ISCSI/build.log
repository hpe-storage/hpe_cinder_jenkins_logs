[2026-11-04T11:59:09.272Z]         }
[2026-11-04T11:59:09.272Z]         /^\[.+\]/ {
[2026-11-04T11:59:09.272Z]             gsub("[][]", "", $1);
[2026-11-04T11:59:09.272Z]             section=$1
[2026-11-04T11:59:09.272Z]             next
[2026-11-04T11:59:09.272Z]         }
[2026-11-04T11:59:09.272Z]         /^ *\#/ {
[2026-11-04T11:59:09.272Z]             next
[2026-11-04T11:59:09.272Z]         }
[2026-11-04T11:59:09.272Z]         /^[^ \t]+/ {
[2026-11-04T11:59:09.272Z]             # get offset of first = in $0
[2026-11-04T11:59:09.273Z]             eq_idx = index($0, "=")
[2026-11-04T11:59:09.273Z]             # extract attr & value from $0
[2026-11-04T11:59:09.273Z]             attr = substr($0, 1, eq_idx - 1)
[2026-11-04T11:59:09.273Z]             value = substr($0, eq_idx + 1)
[2026-11-04T11:59:09.273Z]             # only need to strip trailing whitespace from attr
[2026-11-04T11:59:09.273Z]             sub(/[ \t]*$/, "", attr)
[2026-11-04T11:59:09.273Z]             # need to strip leading & trailing whitespace from value
[2026-11-04T11:59:09.273Z]             sub(/^[ \t]*/, "", value)
[2026-11-04T11:59:09.273Z]             sub(/[ \t]*$/, "", value)
[2026-11-04T11:59:09.273Z] 
[2026-11-04T11:59:09.273Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-11-04T11:59:09.273Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-11-04T11:59:09.273Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-11-04T11:59:09.273Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-11-04T11:59:09.273Z]             if (! (section, attr) in cfg_attr_count) {
[2026-11-04T11:59:09.273Z]                 if (section != last_section) {
[2026-11-04T11:59:09.273Z]                     cfg_section[section_count++] = section
[2026-11-04T11:59:09.273Z]                     last_section = section
[2026-11-04T11:59:09.273Z]                 }
[2026-11-04T11:59:09.273Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-11-04T11:59:09.273Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-11-04T11:59:09.273Z] 
[2026-11-04T11:59:09.273Z]                 cfg_attr[section, attr, 0] = value
[2026-11-04T11:59:09.273Z]                 cfg_attr_count[section, attr] = 1
[2026-11-04T11:59:09.273Z]             } else {
[2026-11-04T11:59:09.273Z]                 lno = cfg_attr_count[section, attr]++
[2026-11-04T11:59:09.273Z]                 cfg_attr[section, attr, lno] = value
[2026-11-04T11:59:09.273Z]             }
