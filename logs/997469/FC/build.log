[2026-09-26T10:18:09.230Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-26T10:18:09.230Z]                         if [ -z "$image_id" ]; then
