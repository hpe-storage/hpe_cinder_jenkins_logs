[2026-09-05T09:39:10.948Z]                         image_id=$(grep -m1 "^image_ref[^_]" /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-09-05T09:39:10.948Z]                         if [ -z "$image_id" ]; then
