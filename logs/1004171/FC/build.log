[2026-09-05T09:39:10.948Z]                         . .tox/tempest/bin/activate
[2026-09-05T09:39:10.948Z]                         export TERM=xterm-256color
[2026-09-05T09:39:10.948Z]                         export OS_TEST_TIMEOUT=3000
