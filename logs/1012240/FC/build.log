[2026-10-26T10:41:13.453Z]         /^ *\#/ {
[2026-10-26T10:41:13.453Z]             next
[2026-10-26T10:41:13.453Z]         }
[2026-10-26T10:41:13.453Z]         /^[^ \t]+/ {
[2026-10-26T10:41:13.453Z]             # get offset of first = in $0
[2026-10-26T10:41:13.453Z]             eq_idx = index($0, "=")
[2026-10-26T10:41:13.453Z]             # extract attr & value from $0
[2026-10-26T10:41:13.453Z]             attr = substr($0, 1, eq_idx - 1)
[2026-10-26T10:41:13.453Z]             value = substr($0, eq_idx + 1)
[2026-10-26T10:41:13.453Z]             # only need to strip trailing whitespace from attr
[2026-10-26T10:41:13.453Z]             sub(/[ \t]*$/, "", attr)
[2026-10-26T10:41:13.453Z]             # need to strip leading & trailing whitespace from value
[2026-10-26T10:41:13.453Z]             sub(/^[ \t]*/, "", value)
[2026-10-26T10:41:13.453Z]             sub(/[ \t]*$/, "", value)
[2026-10-26T10:41:13.453Z] 
