[2026-10-26T10:49:30.545Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-10-26T10:49:30.545Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
