[2026-10-26T10:49:30.545Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-10-26T10:49:30.545Z]                         cd /opt/stack/tempest
[2026-10-26T10:49:30.545Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
