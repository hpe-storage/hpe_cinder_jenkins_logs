[2026-10-15T16:40:59.576Z]                             echo "Volume status: $STATUS (attempt $i/30)"
[2026-10-15T16:40:59.576Z]                             if [ "$STATUS" = "available" ]; then
[2026-10-15T16:40:59.576Z]                                 break
[2026-10-15T16:40:59.576Z]                             elif [ "$STATUS" = "error" ]; then
