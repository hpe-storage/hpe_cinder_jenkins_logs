[2026-10-15T16:40:59.576Z]                                 openstack volume show "$VOL_ID"
[2026-10-15T16:40:59.576Z]                                 exit 1
[2026-10-15T16:40:59.576Z]                             fi
[2026-10-15T16:40:59.576Z]                             sleep 10
[2026-10-15T16:40:59.576Z]                         done
