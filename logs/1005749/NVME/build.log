[2026-09-15T20:55:26.293Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-09-15T20:55:26.293Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
