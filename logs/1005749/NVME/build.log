[2026-09-15T20:55:26.293Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-09-15T20:55:26.293Z]                         cd /opt/stack/tempest
[2026-09-15T20:55:26.293Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
