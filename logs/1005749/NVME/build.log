[2026-09-15T20:55:26.293Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-09-15T20:55:26.293Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
