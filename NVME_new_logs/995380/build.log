[2026-06-29T17:20:16.943Z] 
[2026-06-29T17:20:16.943Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-06-29T17:20:16.943Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-06-29T17:20:16.943Z]                         if [ -z "$image_id" ]; then
[2026-06-29T17:20:16.943Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-06-29T17:20:16.943Z]                             exit 1
[2026-06-29T17:20:16.943Z]                         fi
[2026-06-29T17:20:16.943Z]                         echo "image_id: $image_id"
[2026-06-29T17:20:16.943Z] 
