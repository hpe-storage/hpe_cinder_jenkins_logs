[2026-06-29T17:20:16.943Z]                         sudo wget --no-proxy http://10.132.44.110/skip.txt    -P /opt/stack/tempest/
[2026-06-29T17:20:16.943Z]                         cd /opt/stack/tempest
[2026-06-29T17:20:16.943Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
