[2026-08-25T14:02:19.429Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-08-25T14:02:19.429Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-08-25T14:02:19.429Z]                         cd /opt/stack/tempest
[2026-08-25T14:02:19.429Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
