[2026-08-25T14:02:19.429Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-08-25T14:02:19.429Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-08-25T14:02:19.429Z] 
[2026-08-25T14:02:19.429Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-08-25T14:02:19.429Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
