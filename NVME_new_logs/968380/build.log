[2026-07-01T17:56:12.350Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-07-01T17:56:12.350Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-07-01T17:56:12.350Z]                         cd /opt/stack/tempest
[2026-07-01T17:56:12.350Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
