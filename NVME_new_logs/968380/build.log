[2026-08-19T13:21:18.579Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-08-19T13:21:18.579Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-19T13:21:18.579Z]                         if [ -z "$image_id" ]; then
[2026-08-19T13:21:18.579Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-08-19T13:21:18.579Z]                             exit 1
