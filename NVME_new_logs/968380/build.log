[2026-08-19T13:21:18.579Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-08-19T13:21:18.579Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-08-19T13:21:18.579Z]                         cd /opt/stack/tempest
[2026-08-19T13:21:18.579Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-08-19T13:21:18.579Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/tempest.conf -P /opt/stack/tempest/etc/
[2026-08-19T13:21:18.579Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-08-19T13:21:18.579Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-08-19T13:21:18.579Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-08-19T13:21:18.579Z] 
[2026-08-19T13:21:18.579Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-08-19T13:21:18.579Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
