[2026-07-22T18:34:21.309Z]         }
[2026-07-22T18:34:21.309Z]         /^[^ \t]+/ {
[2026-07-22T18:34:21.309Z]             # get offset of first = in $0
[2026-07-22T18:34:21.309Z]             eq_idx = index($0, "=")
[2026-07-22T18:34:21.309Z]             # extract attr & value from $0
[2026-07-22T18:34:21.309Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-22T18:34:21.309Z]             value = substr($0, eq_idx + 1)
[2026-07-22T18:34:21.309Z]             # only need to strip trailing whitespace from attr
[2026-07-22T18:34:21.309Z]             sub(/[ \t]*$/, "", attr)
[2026-07-22T18:34:21.309Z]             # need to strip leading & trailing whitespace from value
[2026-07-22T18:34:21.309Z]             sub(/^[ \t]*/, "", value)
