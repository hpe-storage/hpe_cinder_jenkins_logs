[2026-08-27T01:43:32.217Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-27T01:43:32.217Z]                         if [ -z "$image_id" ]; then
