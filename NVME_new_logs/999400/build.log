[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-07-31T13:08:37.148Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
