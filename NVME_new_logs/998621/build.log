[2026-07-24T14:39:37.415Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-07-24T14:39:37.415Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-07-24T14:39:37.415Z]                         cd /opt/stack/tempest
[2026-07-24T14:39:37.416Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
