[2026-07-24T14:39:37.415Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-24T14:39:37.415Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-24T14:39:37.415Z]                         if [ -z "$image_id" ]; then
[2026-07-24T14:39:37.415Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-24T14:39:37.415Z]                             exit 1
[2026-07-24T14:39:37.415Z]                         fi
[2026-07-24T14:39:37.415Z]                         echo "image_id: $image_id"
