[2026-07-24T14:39:37.416Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-07-24T14:39:37.416Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-07-24T14:39:37.416Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-07-24T14:39:37.416Z] 
[2026-07-24T14:39:37.416Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-07-24T14:39:37.416Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
[2026-07-24T14:39:37.416Z] 
