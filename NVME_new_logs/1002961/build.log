[2026-08-30T11:36:08.621Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-08-30T11:36:08.621Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
