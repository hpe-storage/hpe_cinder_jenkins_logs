[2026-08-30T11:36:08.621Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-08-30T11:36:08.621Z]                         cd /opt/stack/tempest
[2026-08-30T11:36:08.621Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
