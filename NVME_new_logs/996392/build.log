[2026-07-08T14:38:14.371Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-07-08T14:38:14.371Z] 
[2026-07-08T14:38:14.371Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-08T14:38:14.371Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-08T14:38:14.371Z]                         if [ -z "$image_id" ]; then
[2026-07-08T14:38:14.371Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-08T14:38:14.371Z]                             exit 1
[2026-07-08T14:38:14.371Z]                         fi
[2026-07-08T14:38:14.371Z]                         echo "image_id: $image_id"
[2026-07-08T14:38:14.371Z] 
[2026-07-08T14:38:14.371Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_create_get_update_delete_as_clone)"
[2026-07-08T14:38:14.371Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
