[2026-08-17T20:51:46.966Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-17T20:51:46.966Z]                         if [ -z "$image_id" ]; then
