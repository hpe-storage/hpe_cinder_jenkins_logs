[2026-08-19T19:09:52.270Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-19T19:09:52.270Z]                         if [ -z "$image_id" ]; then
