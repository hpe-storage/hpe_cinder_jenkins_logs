[2026-07-02T23:49:37.140Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
[2026-07-02T23:49:37.140Z] 
