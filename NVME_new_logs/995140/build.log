[2026-07-02T23:49:37.140Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-07-02T23:49:37.140Z] 
[2026-07-02T23:49:37.140Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-02T23:49:37.140Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-02T23:49:37.140Z]                         if [ -z "$image_id" ]; then
[2026-07-02T23:49:37.140Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-02T23:49:37.140Z]                             exit 1
[2026-07-02T23:49:37.140Z]                         fi
[2026-07-02T23:49:37.140Z]                         echo "image_id: $image_id"
[2026-07-02T23:49:37.140Z] 
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_create_get_update_delete_as_clone)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_ebs_image_and_check_boot)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_backup_create_attached_volume)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_from_bootable_volume)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_resize_volume_backed_server_confirm)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_boot_pattern)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_crud_with_volume_type_and_extra_specs)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*VolumesExtendTest.test_volume_extend)"
[2026-07-02T23:49:37.140Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_snapshot_create_delete_with_volume_in_use)"
