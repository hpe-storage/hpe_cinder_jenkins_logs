[2026-07-05T03:58:17.361Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-05T03:58:17.361Z]                         if [ -z "$image_id" ]; then
