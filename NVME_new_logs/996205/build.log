[2026-07-09T07:49:13.664Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-07-09T07:49:13.664Z]                         cd /opt/stack/tempest
[2026-07-09T07:49:13.664Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
