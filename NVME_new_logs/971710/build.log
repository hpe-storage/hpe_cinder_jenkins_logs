[2026-07-03T06:57:05.753Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-03T06:57:05.753Z]                             exit 1
[2026-07-03T06:57:05.753Z]                         fi
[2026-07-03T06:57:05.753Z]                         echo "image_id: $image_id"
