[2026-07-21T05:33:55.723Z] 
[2026-07-21T05:33:55.723Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-21T05:33:55.723Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-21T05:33:55.723Z]                         if [ -z "$image_id" ]; then
[2026-07-21T05:33:55.723Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-21T05:33:55.723Z]                             exit 1
[2026-07-21T05:33:55.723Z]                         fi
[2026-07-21T05:33:55.723Z]                         echo "image_id: $image_id"
