[2026-07-21T05:33:55.723Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_shelve_volume_backed_instance)"
[2026-07-21T05:33:55.723Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_export_import)"
