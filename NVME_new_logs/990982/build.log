[2026-07-04T23:37:17.823Z] 
[2026-07-04T23:37:17.823Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-04T23:37:17.823Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-04T23:37:17.823Z]                         if [ -z "$image_id" ]; then
[2026-07-04T23:37:17.823Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-04T23:37:17.823Z]                             exit 1
