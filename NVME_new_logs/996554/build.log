[2026-08-18T15:23:26.730Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-08-18T15:23:26.730Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
