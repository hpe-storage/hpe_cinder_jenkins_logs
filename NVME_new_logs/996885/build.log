[2026-07-11T16:40:17.784Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-11T16:40:17.784Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-11T16:40:17.784Z]                         if [ -z "$image_id" ]; then
[2026-07-11T16:40:17.784Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-11T16:40:17.784Z]                             exit 1
