[2026-08-09T07:54:51.538Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-08-09T07:54:51.538Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-09T07:54:51.538Z]                         if [ -z "$image_id" ]; then
