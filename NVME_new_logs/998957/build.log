[2026-08-09T07:54:51.538Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-08-09T07:54:51.538Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-08-09T07:54:51.538Z]                         cd /opt/stack/tempest
[2026-08-09T07:54:51.538Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
