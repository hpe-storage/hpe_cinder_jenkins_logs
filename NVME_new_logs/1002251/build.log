[2026-08-25T15:20:14.683Z]                         openstack subnet create public_subnet                             --allocation-pool start=192.168.1.2,end=192.168.1.100                             --network public                             --subnet-range 192.168.1.0/24
[2026-08-25T15:20:14.683Z] 
[2026-08-25T15:20:14.683Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-08-25T15:20:14.684Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-25T15:20:14.684Z]                         if [ -z "$image_id" ]; then
[2026-08-25T15:20:14.684Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-08-25T15:20:14.684Z]                             exit 1
[2026-08-25T15:20:14.684Z]                         fi
[2026-08-25T15:20:14.684Z]                         echo "image_id: $image_id"
