[2026-06-24T09:23:37.439Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-06-24T09:23:37.439Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-06-24T09:23:37.439Z]                         if [ -z "$image_id" ]; then
