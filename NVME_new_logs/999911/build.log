[2026-08-31T19:16:49.858Z]                                 openstack volume show "$VOL_ID"
[2026-08-31T19:16:49.858Z]                                 exit 1
[2026-08-31T19:16:49.858Z]                             fi
[2026-08-31T19:16:49.858Z]                             sleep 10
[2026-08-31T19:16:49.858Z]                         done
