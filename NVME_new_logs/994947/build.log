[2026-06-26T18:23:27.530Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-06-26T18:23:27.530Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
