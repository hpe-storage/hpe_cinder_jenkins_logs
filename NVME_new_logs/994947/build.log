[2026-06-26T18:23:27.530Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-06-26T18:23:27.530Z]                         sudo wget --no-proxy http://10.132.44.110/skip.txt    -P /opt/stack/tempest/
[2026-06-26T18:23:27.530Z]                         cd /opt/stack/tempest
[2026-06-26T18:23:27.530Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
