[2026-06-26T17:34:09.538Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-06-26T17:34:09.538Z]                         sudo wget --no-proxy http://10.132.44.110/skip.txt    -P /opt/stack/tempest/
[2026-06-26T17:34:09.538Z]                         cd /opt/stack/tempest
[2026-06-26T17:34:09.538Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
