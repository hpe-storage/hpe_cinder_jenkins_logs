[2026-06-26T17:34:09.538Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-06-26T17:34:09.538Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
