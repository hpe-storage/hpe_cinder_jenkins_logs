[2026-06-26T00:49:18.524Z]                         # Download NVMe/TCP-specific tempest.conf and skip list
[2026-06-26T00:49:18.524Z]                         sudo wget --no-proxy http://10.132.44.110/skip.txt    -P /opt/stack/tempest/
[2026-06-26T00:49:18.524Z]                         cd /opt/stack/tempest
[2026-06-26T00:49:18.524Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
[2026-06-26T00:49:18.524Z]                         sudo wget --no-proxy http://10.132.44.110/tempest.conf -P /opt/stack/tempest/etc/
[2026-06-26T00:49:18.524Z]                         sudo chown stack:stack /opt/stack/tempest/etc/tempest.conf
[2026-06-26T00:49:18.524Z]                         sudo sed -i "s/192.168.1.2/${HOST_IP}/g"              /opt/stack/tempest/etc/tempest.conf
[2026-06-26T00:49:18.524Z]                         sudo sed -i "s/1111111111111111111111111/${image_id}/g" /opt/stack/tempest/etc/tempest.conf
[2026-06-26T00:49:18.524Z] 
[2026-06-26T00:49:18.524Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-06-26T00:49:18.524Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
