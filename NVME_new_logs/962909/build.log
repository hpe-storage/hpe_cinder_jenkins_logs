[2026-07-10T09:39:23.934Z] 
[2026-07-10T09:39:23.934Z]                         # Fix storage_protocol to match what the HPE driver reports
[2026-07-10T09:39:23.934Z]                         sudo sed -i "s/^\(\s*\)storage_protocol\s*=.*/\1storage_protocol = NVMe-TCP/" /opt/stack/tempest/etc/tempest.conf
