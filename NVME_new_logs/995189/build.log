[2026-07-21T12:49:40.480Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-21T12:49:40.480Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-21T12:49:40.480Z]                         if [ -z "$image_id" ]; then
