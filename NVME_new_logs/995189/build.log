[2026-07-21T12:49:40.480Z]                         sudo wget --no-proxy http://10.132.239.244/nvme/skip.txt    -P /opt/stack/tempest/
[2026-07-21T12:49:40.480Z]                         cd /opt/stack/tempest
[2026-07-21T12:49:40.480Z]                         mv /opt/stack/tempest/etc/tempest.conf /opt/stack/tempest/etc/tempest.conf_old
