[2026-07-12T15:29:57.357Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-12T15:29:57.357Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-12T15:29:57.357Z]                         if [ -z "$image_id" ]; then
[2026-07-12T15:29:57.357Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-12T15:29:57.357Z]                             exit 1
[2026-07-12T15:29:57.357Z]                         fi
[2026-07-12T15:29:57.357Z]                         echo "image_id: $image_id"
[2026-07-12T15:29:57.357Z] 
[2026-07-12T15:29:57.357Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_create_get_update_delete_as_clone)"
[2026-07-12T15:29:57.357Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
