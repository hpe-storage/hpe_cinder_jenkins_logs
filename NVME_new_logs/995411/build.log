[2026-07-01T11:19:26.223Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-01T11:19:26.223Z]                         if [ -z "$image_id" ]; then
