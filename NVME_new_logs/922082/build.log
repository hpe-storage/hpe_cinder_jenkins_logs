[2026-06-30T14:25:16.067Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_volume_backup_create_get_detailed_list_restore_delete)"
[2026-06-30T14:25:16.067Z]                         export DEVSTACK_GATE_TEMPEST_REGEX+="(?!.*test_create_ebs_image_and_check_boot)"
