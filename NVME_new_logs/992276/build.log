[2026-07-30T13:51:15.553Z]                         # Extract image_id from DevStack-generated tempest.conf before overwriting it
[2026-07-30T13:51:15.553Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-07-30T13:51:15.553Z]                         if [ -z "$image_id" ]; then
[2026-07-30T13:51:15.553Z]                             echo "ERROR: Could not extract image_ref from tempest.conf"
[2026-07-30T13:51:15.553Z]                             exit 1
[2026-07-30T13:51:15.553Z]                         fi
[2026-07-30T13:51:15.553Z]                         echo "image_id: $image_id"
