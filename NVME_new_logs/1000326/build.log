[2026-08-10T14:01:25.754Z]                         image_id=$(grep -m1 ^image_ref /opt/stack/tempest/etc/tempest.conf | cut -d= -f2 | tr -d " ")
[2026-08-10T14:01:25.754Z]                         if [ -z "$image_id" ]; then
