[2026-06-30T07:54:52.738Z]         }
[2026-06-30T07:54:52.738Z]         /^ *\#/ {
[2026-06-30T07:54:52.738Z]             next
[2026-06-30T07:54:52.738Z]         }
[2026-06-30T07:54:52.738Z]         /^[^ \t]+/ {
[2026-06-30T07:54:52.738Z]             # get offset of first = in $0
[2026-06-30T07:54:52.738Z]             eq_idx = index($0, "=")
[2026-06-30T07:54:52.738Z]             # extract attr & value from $0
[2026-06-30T07:54:52.738Z]             attr = substr($0, 1, eq_idx - 1)
[2026-06-30T07:54:52.738Z]             value = substr($0, eq_idx + 1)
[2026-06-30T07:54:52.738Z]             # only need to strip trailing whitespace from attr
[2026-06-30T07:54:52.738Z]             sub(/[ \t]*$/, "", attr)
[2026-06-30T07:54:52.738Z]             # need to strip leading & trailing whitespace from value
[2026-06-30T07:54:52.738Z]             sub(/^[ \t]*/, "", value)
[2026-06-30T07:54:52.738Z]             sub(/[ \t]*$/, "", value)
[2026-06-30T07:54:52.738Z] 
[2026-06-30T07:54:52.738Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-06-30T07:54:52.738Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-06-30T07:54:52.738Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-06-30T07:54:52.739Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-06-30T07:54:52.739Z]             if (! (section, attr) in cfg_attr_count) {
