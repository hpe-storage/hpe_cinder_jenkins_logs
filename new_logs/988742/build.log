[2026-06-30T07:54:52.739Z]                 cfg_attr_count[section, attr] = 1
[2026-06-30T07:54:52.739Z]             } else {
[2026-06-30T07:54:52.739Z]                 lno = cfg_attr_count[section, attr]++
[2026-06-30T07:54:52.739Z]                 cfg_attr[section, attr, lno] = value
[2026-06-30T07:54:52.739Z]             }
[2026-06-30T07:54:52.739Z]         }
[2026-06-30T07:54:52.739Z]         END {
[2026-06-30T07:54:52.739Z]             # Process each section in order
[2026-06-30T07:54:52.739Z]             for (sno = 0; sno < section_count; sno++) {
[2026-06-30T07:54:52.739Z]                 section = cfg_section[sno]
[2026-06-30T07:54:52.739Z]                 # The ini routines simply append a config item immediately
