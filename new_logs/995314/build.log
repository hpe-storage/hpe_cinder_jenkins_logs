[2026-07-01T07:59:33.135Z]         END {
[2026-07-01T07:59:33.135Z]             # Process each section in order
[2026-07-01T07:59:33.135Z]             for (sno = 0; sno < section_count; sno++) {
[2026-07-01T07:59:33.135Z]                 section = cfg_section[sno]
[2026-07-01T07:59:33.135Z]                 # The ini routines simply append a config item immediately
[2026-07-01T07:59:33.135Z]                 # after the section header. To keep the same order as defined
[2026-07-01T07:59:33.135Z]                 # in local.conf, invoke the ini routines in the reverse order
