[2026-07-01T07:59:33.135Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-07-01T07:59:33.135Z] 
[2026-07-01T07:59:33.135Z]                 cfg_attr[section, attr, 0] = value
[2026-07-01T07:59:33.135Z]                 cfg_attr_count[section, attr] = 1
[2026-07-01T07:59:33.135Z]             } else {
[2026-07-01T07:59:33.135Z]                 lno = cfg_attr_count[section, attr]++
[2026-07-01T07:59:33.135Z]                 cfg_attr[section, attr, lno] = value
[2026-07-01T07:59:33.135Z]             }
