[2026-07-01T07:59:33.134Z]             gsub("[][]", "", $1);
[2026-07-01T07:59:33.134Z]             section=$1
[2026-07-01T07:59:33.134Z]             next
[2026-07-01T07:59:33.134Z]         }
[2026-07-01T07:59:33.134Z]         /^ *\#/ {
[2026-07-01T07:59:33.134Z]             next
[2026-07-01T07:59:33.134Z]         }
[2026-07-01T07:59:33.134Z]         /^[^ \t]+/ {
[2026-07-01T07:59:33.134Z]             # get offset of first = in $0
[2026-07-01T07:59:33.134Z]             eq_idx = index($0, "=")
[2026-07-01T07:59:33.134Z]             # extract attr & value from $0
[2026-07-01T07:59:33.134Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-01T07:59:33.134Z]             value = substr($0, eq_idx + 1)
[2026-07-01T07:59:33.134Z]             # only need to strip trailing whitespace from attr
[2026-07-01T07:59:33.134Z]             sub(/[ \t]*$/, "", attr)
[2026-07-01T07:59:33.134Z]             # need to strip leading & trailing whitespace from value
[2026-07-01T07:59:33.134Z]             sub(/^[ \t]*/, "", value)
[2026-07-01T07:59:33.134Z]             sub(/[ \t]*$/, "", value)
[2026-07-01T07:59:33.134Z] 
[2026-07-01T07:59:33.134Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-07-01T07:59:33.135Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-07-01T07:59:33.135Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-07-01T07:59:33.135Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-07-01T07:59:33.135Z]             if (! (section, attr) in cfg_attr_count) {
[2026-07-01T07:59:33.135Z]                 if (section != last_section) {
[2026-07-01T07:59:33.135Z]                     cfg_section[section_count++] = section
[2026-07-01T07:59:33.135Z]                     last_section = section
[2026-07-01T07:59:33.135Z]                 }
