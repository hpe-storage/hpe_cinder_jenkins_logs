[2026-06-29T20:40:41.595Z]         /^\[.+\]/ {
[2026-06-29T20:40:41.595Z]             gsub("[][]", "", $1);
[2026-06-29T20:40:41.595Z]             section=$1
[2026-06-29T20:40:41.595Z]             next
[2026-06-29T20:40:41.595Z]         }
[2026-06-29T20:40:41.595Z]         /^ *\#/ {
[2026-06-29T20:40:41.595Z]             next
[2026-06-29T20:40:41.595Z]         }
[2026-06-29T20:40:41.595Z]         /^[^ \t]+/ {
[2026-06-29T20:40:41.595Z]             # get offset of first = in $0
[2026-06-29T20:40:41.595Z]             eq_idx = index($0, "=")
[2026-06-29T20:40:41.595Z]             # extract attr & value from $0
[2026-06-29T20:40:41.595Z]             attr = substr($0, 1, eq_idx - 1)
[2026-06-29T20:40:41.595Z]             value = substr($0, eq_idx + 1)
[2026-06-29T20:40:41.595Z]             # only need to strip trailing whitespace from attr
[2026-06-29T20:40:41.595Z]             sub(/[ \t]*$/, "", attr)
[2026-06-29T20:40:41.595Z]             # need to strip leading & trailing whitespace from value
[2026-06-29T20:40:41.595Z]             sub(/^[ \t]*/, "", value)
[2026-06-29T20:40:41.595Z]             sub(/[ \t]*$/, "", value)
[2026-06-29T20:40:41.595Z] 
[2026-06-29T20:40:41.595Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-06-29T20:40:41.595Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-06-29T20:40:41.595Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-06-29T20:40:41.595Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-06-29T20:40:41.595Z]             if (! (section, attr) in cfg_attr_count) {
[2026-06-29T20:40:41.595Z]                 if (section != last_section) {
[2026-06-29T20:40:41.595Z]                     cfg_section[section_count++] = section
[2026-06-29T20:40:41.595Z]                     last_section = section
[2026-06-29T20:40:41.595Z]                 }
[2026-06-29T20:40:41.595Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-06-29T20:40:41.595Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-06-29T20:40:41.595Z] 
[2026-06-29T20:40:41.596Z]                 cfg_attr[section, attr, 0] = value
[2026-06-29T20:40:41.596Z]                 cfg_attr_count[section, attr] = 1
[2026-06-29T20:40:41.596Z]             } else {
[2026-06-29T20:40:41.596Z]                 lno = cfg_attr_count[section, attr]++
[2026-06-29T20:40:41.596Z]                 cfg_attr[section, attr, lno] = value
[2026-06-29T20:40:41.596Z]             }
[2026-06-29T20:40:41.596Z]         }
[2026-06-29T20:40:41.596Z]         END {
[2026-06-29T20:40:41.596Z]             # Process each section in order
[2026-06-29T20:40:41.596Z]             for (sno = 0; sno < section_count; sno++) {
[2026-06-29T20:40:41.596Z]                 section = cfg_section[sno]
[2026-06-29T20:40:41.596Z]                 # The ini routines simply append a config item immediately
[2026-06-29T20:40:41.596Z]                 # after the section header. To keep the same order as defined
[2026-06-29T20:40:41.596Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-06-29T20:40:41.596Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
