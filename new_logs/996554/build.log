[2026-08-20T15:19:28.458Z]                         for i in $(seq 1 30); do
[2026-08-20T15:19:28.458Z]                             STATUS=$(openstack volume show "$VOL_ID" -f value -c status)
[2026-08-20T15:19:28.458Z]                             echo "Volume status: $STATUS (attempt $i/30)"
[2026-08-20T15:19:28.458Z]                             if [ "$STATUS" = "available" ]; then
[2026-08-20T15:19:28.458Z]                                 break
[2026-08-20T15:19:28.458Z]                             elif [ "$STATUS" = "error" ]; then
[2026-08-20T15:19:28.458Z]                                 echo "Volume creation failed!"
[2026-08-20T15:19:28.458Z]                                 openstack volume show "$VOL_ID"
[2026-08-20T15:19:28.458Z]                                 exit 1
[2026-08-20T15:19:28.458Z]                             fi
[2026-08-20T15:19:28.458Z]                             sleep 10
[2026-08-20T15:19:28.458Z]                         done
[2026-08-20T15:19:28.458Z] 
[2026-08-20T15:19:28.458Z]                         openstack volume show "$VOL_ID"
[2026-08-20T15:19:28.458Z]                         openstack volume delete "$VOL_ID"
[2026-08-20T15:19:28.458Z]                         echo "Smoke test passed."
