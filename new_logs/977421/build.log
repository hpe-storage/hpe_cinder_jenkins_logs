[2026-07-05T18:37:50.280Z]             # only need to strip trailing whitespace from attr
[2026-07-05T18:37:50.280Z]             sub(/[ \t]*$/, "", attr)
[2026-07-05T18:37:50.280Z]             # need to strip leading & trailing whitespace from value
[2026-07-05T18:37:50.280Z]             sub(/^[ \t]*/, "", value)
[2026-07-05T18:37:50.280Z]             sub(/[ \t]*$/, "", value)
[2026-07-05T18:37:50.280Z] 
