[2026-07-05T18:37:50.280Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-07-05T18:37:50.280Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-07-05T18:37:50.280Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-07-05T18:37:50.280Z]             if (! (section, attr) in cfg_attr_count) {
[2026-07-05T18:37:50.280Z]                 if (section != last_section) {
[2026-07-05T18:37:50.280Z]                     cfg_section[section_count++] = section
[2026-07-05T18:37:50.280Z]                     last_section = section
[2026-07-05T18:37:50.280Z]                 }
[2026-07-05T18:37:50.280Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-07-05T18:37:50.280Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-07-05T18:37:50.280Z] 
