[2026-07-05T18:37:50.281Z]                         count = cfg_attr_count[section, attr]
[2026-07-05T18:37:50.281Z]                         print "inidelete " configfile " " section " " attr
[2026-07-05T18:37:50.281Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-07-05T18:37:50.281Z]                         for (l = count -2; l >= 0; l--)
[2026-07-05T18:37:50.281Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-07-05T18:37:50.281Z]                     }
[2026-07-05T18:37:50.281Z]                 }
