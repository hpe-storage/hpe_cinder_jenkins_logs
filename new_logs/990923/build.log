[2026-07-03T18:33:15.836Z]         }
[2026-07-03T18:33:15.836Z]         /^ *\#/ {
[2026-07-03T18:33:15.836Z]             next
[2026-07-03T18:33:15.836Z]         }
[2026-07-03T18:33:15.836Z]         /^[^ \t]+/ {
[2026-07-03T18:33:15.836Z]             # get offset of first = in $0
[2026-07-03T18:33:15.836Z]             eq_idx = index($0, "=")
[2026-07-03T18:33:15.836Z]             # extract attr & value from $0
[2026-07-03T18:33:15.836Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-03T18:33:15.836Z]             value = substr($0, eq_idx + 1)
[2026-07-03T18:33:15.836Z]             # only need to strip trailing whitespace from attr
[2026-07-03T18:33:15.837Z]             sub(/[ \t]*$/, "", attr)
[2026-07-03T18:33:15.837Z]             # need to strip leading & trailing whitespace from value
[2026-07-03T18:33:15.837Z]             sub(/^[ \t]*/, "", value)
[2026-07-03T18:33:15.837Z]             sub(/[ \t]*$/, "", value)
[2026-07-03T18:33:15.837Z] 
[2026-07-03T18:33:15.837Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-07-03T18:33:15.837Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-07-03T18:33:15.837Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-07-03T18:33:15.837Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-07-03T18:33:15.837Z]             if (! (section, attr) in cfg_attr_count) {
[2026-07-03T18:33:15.837Z]                 if (section != last_section) {
[2026-07-03T18:33:15.837Z]                     cfg_section[section_count++] = section
[2026-07-03T18:33:15.837Z]                     last_section = section
[2026-07-03T18:33:15.837Z]                 }
