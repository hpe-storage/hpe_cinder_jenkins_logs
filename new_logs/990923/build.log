[2026-07-03T18:33:15.837Z]                 cfg_attr_count[section, attr] = 1
[2026-07-03T18:33:15.837Z]             } else {
[2026-07-03T18:33:15.837Z]                 lno = cfg_attr_count[section, attr]++
[2026-07-03T18:33:15.837Z]                 cfg_attr[section, attr, lno] = value
[2026-07-03T18:33:15.837Z]             }
[2026-07-03T18:33:15.837Z]         }
[2026-07-03T18:33:15.837Z]         END {
[2026-07-03T18:33:15.837Z]             # Process each section in order
[2026-07-03T18:33:15.837Z]             for (sno = 0; sno < section_count; sno++) {
[2026-07-03T18:33:15.837Z]                 section = cfg_section[sno]
[2026-07-03T18:33:15.837Z]                 # The ini routines simply append a config item immediately
[2026-07-03T18:33:15.838Z]                 # after the section header. To keep the same order as defined
