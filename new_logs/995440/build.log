[2026-06-30T07:07:49.136Z]         /^[^ \t]+/ {
[2026-06-30T07:07:49.136Z]             # get offset of first = in $0
[2026-06-30T07:07:49.136Z]             eq_idx = index($0, "=")
[2026-06-30T07:07:49.136Z]             # extract attr & value from $0
[2026-06-30T07:07:49.136Z]             attr = substr($0, 1, eq_idx - 1)
[2026-06-30T07:07:49.136Z]             value = substr($0, eq_idx + 1)
[2026-06-30T07:07:49.136Z]             # only need to strip trailing whitespace from attr
[2026-06-30T07:07:49.136Z]             sub(/[ \t]*$/, "", attr)
[2026-06-30T07:07:49.136Z]             # need to strip leading & trailing whitespace from value
[2026-06-30T07:07:49.136Z]             sub(/^[ \t]*/, "", value)
[2026-06-30T07:07:49.136Z]             sub(/[ \t]*$/, "", value)
[2026-06-30T07:07:49.136Z] 
[2026-06-30T07:07:49.136Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-06-30T07:07:49.136Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-06-30T07:07:49.136Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
